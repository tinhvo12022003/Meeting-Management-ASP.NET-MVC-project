@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model DepartmentCreateModel

@{
    ViewData["Title"] = "Thêm Phòng ban";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companies = ViewBag.Companies as List<CompanyViewModel> ?? new List<CompanyViewModel>();
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 p-0 bg-transparent">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted small">Quản lý Phòng ban</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Thêm mới</li>
                </ol>
            </nav>

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle mr-3 shadow-sm" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-arrow-left text-muted"></i>
                </a>
                <h3 class="font-weight-bold mb-0">Tạo phòng ban mới</h3>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" id="createDeptForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" style="border-radius: 8px;"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Name" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Tên phòng ban <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-sitemap text-muted"></i></span>
                                    </div>
                                    <input asp-for="Name" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Ví dụ: Phòng Kỹ thuật, Marketing..." required>
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="CompanyId" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Trực thuộc công ty <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-control custom-select bg-light" style="border-radius: 8px;" required>
                                    <option value="">-- Chọn công ty --</option>
                                    @foreach (var company in companies)
                                    {
                                        <option value="@company.Id">@company.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CompanyId" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="RowStatus" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Trạng thái ban đầu</label>
                                <select asp-for="RowStatus" class="form-control custom-select bg-light" style="border-radius: 8px;">
                                    <option value="@RowStatus.ACTIVE">Hoạt động</option>
                                    <option value="@RowStatus.INACTIVE">Tạm dừng</option>
                                </select>
                                <span asp-validation-for="RowStatus" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <hr class="my-4 border-light">

                        <div class="d-flex justify-content-end align-items-center">
                            <a asp-action="Index" class="btn btn-link text-muted mr-4 text-decoration-none small font-weight-bold">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-5 py-2 font-weight-bold shadow-sm" style="border-radius: 10px; background: #4f46e5; border: none;">
                                <i class="fas fa-save mr-2"></i> Lưu phòng ban
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Hint Section -->
            <div class="mt-4 p-3 bg-light rounded" style="border-left: 4px solid #4f46e5;">
                <p class="small text-muted mb-0">
                    <i class="fas fa-info-circle mr-2 text-primary"></i>
                    <strong>Gợi ý:</strong> Tên phòng ban nên ngắn gọn và mang tính mô tả cao. Sau khi tạo, bạn có thể thêm nhân sự vào phòng ban này từ mục Quản lý Người dùng.
                </p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-control:focus, .custom-select:focus {
            background-color: #fff !important;
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }
        
        .input-group-merge .form-control {
            border-left: 0;
        }
        
        .input-group-merge .input-group-text {
            border-right: 0;
            border-radius: 8px 0 0 8px;
        }
    </style>
}
