@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model DepartmentUpdateModel

@{
    ViewData["Title"] = "Cập nhật Phòng ban";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companies = ViewBag.Companies as List<CompanyViewModel> ?? new List<CompanyViewModel>();
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Breadcrumb -->
            @* <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 p-0 bg-transparent">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted small">Quản lý Phòng ban</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Cập nhật</li>
                </ol>
            </nav> *@

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle mr-3 shadow-sm" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-arrow-left text-muted"></i>
                </a>
                <h3 class="font-weight-bold mb-0">Cập nhật phòng ban</h3>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Update" method="post" id="updateDeptForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" style="border-radius: 8px;"></div>
                        
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Name" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Tên phòng ban <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-sitemap text-muted"></i></span>
                                    </div>
                                    <input asp-for="Name" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Ví dụ: Phòng Kỹ thuật, Marketing..." required>
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="CompanyId" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Trực thuộc công ty <span class="text-danger">*</span></label>
                                <select asp-for="CompanyId" class="form-control custom-select bg-light" style="border-radius: 8px;" required>
                                    <option value="">-- Chọn công ty --</option>
                                    @foreach (var company in companies)
                                    {
                                        if (Model.CompanyId == company.Id)
                                        {
                                            <option value="@company.Id" selected>@company.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@company.Id">@company.Name</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="CompanyId" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Location" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Vị trí</label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-sitemap text-muted"></i></span>
                                    </div>
                                    <input asp-for="Location" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Ví dụ: Tòa nhà chính..." required>
                                </div>
                                <span asp-validation-for="Location" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <hr class="my-4 border-light">

                        <div class="d-flex flex-column flex-md-row justify-content-md-end align-items-stretch align-items-md-center gap-2">

                            <a asp-action="Index"
                            class="btn btn-link text-muted text-decoration-none small font-weight-bold w-100 w-md-auto">
                                Hủy bỏ
                            </a>

                            <button type="submit"
                                class="btn btn-primary px-md-5 py-2 font-weight-bold shadow-sm w-100 w-md-auto"
                                style="border-radius:10px;background:#4f46e5;border:none;">
                                <i class="fas fa-save me-2"></i> Lưu thay đổi
                            </button>

                        </div>
                    </form>
                </div>
            </div>

            <!-- Hint Section -->
            <div class="mt-4 p-3 bg-light rounded" style="border-left: 4px solid #4f46e5;">
                <p class="small text-muted mb-0">
                    <i class="fas fa-info-circle mr-2 text-primary"></i>
                    <strong>Lưu ý:</strong> Việc thay đổi công ty trực thuộc sẽ ảnh hưởng đến việc phân cấp quản lý và truy cập dữ liệu của các nhân sự trong phòng ban này.
                </p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-update-department.css" />
}
