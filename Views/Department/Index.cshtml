@using MeetingManagement.Common
@using MeetingManagement.Models.DTOs
@model PaginatedResponse<DepartmentViewModel>

@{
    ViewData["Title"] = "Cấu trúc Phòng ban";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            @* <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 p-0 bg-transparent">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">Quản trị</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Phòng ban</li>
                </ol>
            </nav> *@
            <h3 class="font-weight-bold mb-0">Cấu trúc Phòng ban</h3>
            @* <p class="text-muted small mb-0">Quản lý và tổ chức các đơn vị nội bộ trong công ty.</p> *@
        </div>
        <div>
            @* <button class="btn btn-outline-secondary mr-2" style="border-radius: 8px;">
                <i class="fas fa-download mr-1"></i> Xuất báo cáo
            </button> *@
            <a asp-action="Create" class="btn btn-primary px-4"
               style="border-radius: 8px; background: #4f46e5; border: none;">
                <i class="fas fa-plus mr-1"></i> Thêm phòng ban
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background: #eef2ff; color: #4f46e5;">
                <i class="fas fa-network-wired"></i>
            </div>
            <div class="stat-content">
                <span class="label">Tổng số phòng</span>
                <span class="value">@Model.TotalRecords</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #f0fdf4; color: #16a34a;">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="stat-content">
                <span class="label">Đang hoạt động</span>
                <span class="value">@Model.Items.Count</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fff7ed; color: #ea580c;">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <span class="label">Tổng nhân sự</span>
                <span class="value">@Model.Items.Sum(x => x.TotalStaff)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fdf2f8; color: #db2777;">
                <i class="fas fa-project-diagram"></i>
            </div>
            <div class="stat-content">
                <span class="label">Phòng ban mới</span>
                <span class="value">1</span>
            </div>
        </div>
    </div>

    <!-- Departments Table Section -->
    <div class="table-container">
        <div class="table-header">
            <div class="search-box">
                <form method="get" id="filterForm" class="d-flex w-100 gap-3">
                    <div class="position-relative flex-grow-1">
                        <i class="fas fa-search"></i>
                        <input type="text" name="searchTerm" id="deptSearch"
                               placeholder="Tìm tên phòng ban..."
                               value="@ViewContext.HttpContext.Request.Query["searchTerm"]">
                    </div>
                    
                    <div class="company-filter" style="min-width: 200px;">
                        @{
                            List<CompanyViewModel>? companies = ViewBag.Companies as List<CompanyViewModel> ?? new List<CompanyViewModel>();
                            var selectedCompanyId = ViewBag.SelectedCompanyId?.ToString();
                        }
                        <select name="companyId" class="form-control" style="border-radius: 10px; height: 45px; border: 1px solid #e2e8f0;" onchange="document.getElementById('filterForm').submit()">
                            <option value="">-- Tất cả công ty --</option>
                            @foreach (CompanyViewModel company in companies)
                            {
                                <option value="@company.Id" selected="@(selectedCompanyId == company.Id)">@company.Name</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
        </div>

        <div class="custom-table-wrapper">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Phòng ban</th>
                        <th>Trưởng bộ phận</th>
                        <th>Nhân sự</th>
                        <th>Vị trí</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="deptTableBody">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="dept-cell">
                                        <div class="dept-icon" style="background: #eef2ff; color: #4f46e5;">
                                            <i class="fas fa-laptop-code"></i>
                                        </div>
                                        <div class="dept-info">
                                            <span class="name">@item.Name</span>
                                            @* <span class="code">@item.Code</span> *@
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="manager-cell">
                                        <div class="manager-avatar"
                                             style="background-image: url('https://ui-avatars.com/api/?name=@item.ManagerName&background=random'); background-size: cover;">
                                        </div>
                                        <span>@item.ManagerName</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="emp-count">
                                        <i class="fas fa-users"></i>
                                        <span>@item.TotalStaff</span>
                                    </div>
                                </td>
                                <td>@item.Location</td>
                                <td>
                                    <div class="action-btns justify-content-end">
                                        @* <a href="#" class="btn-icon btn-view" title="Xem chi tiết">
                                            <i class="fas fa-eye"></i>
                                        </a> *@
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn-icon btn-edit" title="Chỉnh sửa">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" asp-controller="Department" method="post" id="deleteForm-@item.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="button" class="btn-icon-link btn-delete" title="Xóa" onclick="confirmDelete('@item.Id', '@item.Name', @item.TotalStaff)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="text-muted">Không tìm thấy phòng ban nào phù hợp.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            <div class="pagination-info">
                Hiển thị <b>@Model?.Items?.Count</b> trên tổng số <b>@Model?.TotalRecords</b> phòng ban
            </div>
            <div class="pagination-btns">
                <a class="btn-page @(Model?.PageNumber <= 1 ? "disabled" : "")" 
                   href="@Url.Action("Index", new { pageNumber = Model?.PageNumber - 1, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"], companyId = ViewBag.SelectedCompanyId })">
                   <i class="fas fa-chevron-left"></i>
                </a>
                
                @for (int i = 1; i <= Math.Ceiling((double)Model!.TotalRecords / Model.PageSize); i++)
                {
                    <a class="btn-page @(i == Model.PageNumber ? "active" : "")" 
                       href="@Url.Action("Index", new { pageNumber = i, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"], companyId = ViewBag.SelectedCompanyId })">@i</a>
                }
                
                <a class="btn-page @(Model.PageNumber >= Math.Ceiling((double)Model.TotalRecords / Model.PageSize) ? "disabled" : "")" 
                   href="@Url.Action("Index", new { pageNumber = Model.PageNumber + 1, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"], companyId = ViewBag.SelectedCompanyId })">
                   <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/index-department.css" />
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var successMsg = '@TempData["Success"]';
            var errorMsg = '@TempData["Error"]';
            
            if (successMsg) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMsg,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
            
            if (errorMsg) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMsg,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });

        function confirmDelete(id, name, staffCount) {
            if (staffCount > 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'Không thể xóa!',
                    text: `Phòng ban "${name}" đang có ${staffCount} nhân viên. Vui lòng chuyển nhân viên sang phòng ban khác trước khi xóa.`,
                    confirmButtonColor: '#4f46e5'
                });
                return;
            }

            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn đang chuẩn bị xóa phòng ban "${name}". Dữ liệu nhân sự liên quan có thể bị ảnh hưởng.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.getElementById('deleteForm-' + id);
                    if (form) {
                        form.submit();
                    }
                }
            });
        }
    </script>
}