@using MeetingManagement.Common
@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model PaginatedResponse<MeetingViewModel>
@inject MeetingManagement.Helper.UserHelper UserHelper

@{
    ViewData["Title"] = "Quản lý Lịch họp";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentUserId = UserHelper.GetCurrentUser();
    var canEditOthers = await UserHelper.HasPermission("Meeting.Update.EditAll");
    var userProfile = await UserHelper.GetCurrentUserProfile();
    var isAdmin = await UserHelper.IsAdmin();
    var hasFullMeetingPermission = await UserHelper.HasPermission("Meeting.*") || await UserHelper.HasPermission("Meeting.Index.FullPermission");
    var showFilters = isAdmin || hasFullMeetingPermission;
}

<div class="container-fluid py-4">
    <div class="page-header">
        <div class="header-title">
            <h3>Quản lý Lịch họp</h3>
            <p class="text-muted small">Theo dõi và sắp xếp các cuộc họp hiệu quả</p>
        </div>
        <div class="header-actions">
            <button class="btn-header btn-header-outline" id="toggleViewBtn">
                <i class="fas fa-list"></i>
                <span id="toggleText">Chế độ Danh sách</span>
            </button>
            @* <button class="btn-header btn-header-outline" id="refreshCalendarBtn" title="Làm mới lịch từ server">
                <i class="fas fa-sync-alt"></i>
                Làm mới
            </button> *@
            @* <a asp-action="Create" class="btn-header btn-header-primary">
                <i class="fas fa-plus"></i>
                Tạo cuộc họp
            </a> *@
        </div>
    </div>
    <!-- Quick Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background: #eef2ff; color: #4f46e5;">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="stat-content">
                <span class="label">Tổng cuộc họp</span>
                <span class="value">@Model.TotalRecords</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #f0fdf4; color: #16a34a;">
                <i class="fas fa-clock"></i>
            </div>
            <div class="stat-content">
                <span class="label">Sắp diễn ra</span>
                <span class="value">@Model.Items.Count(x => x.StartAt > DateTime.Now)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fff7ed; color: #ea580c;">
                <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-content">
                <span class="label">Phòng bận hôm nay</span>
                <span class="value">3</span> <!-- Placeholder for today's active rooms -->
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fdf2f8; color: #db2777;">
                <i class="fas fa-video"></i>
            </div>
            <div class="stat-content">
                <span class="label">Họp trực tuyến</span>
                <span class="value">@Model.Items.Count(x => !string.IsNullOrEmpty(x.Url))</span>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="content-container">
        <!-- Calendar View -->
        <div id="calendarView" class="view-section">
            <div class="row">
                <!-- Sidebar: Draggable Events & Quick Create -->
                <div class="col-lg-3">
                    <div class="sticky-top mb-3" style="top: 20px; z-index: 10;">
                        <!-- Draggable Events Card -->
                        <div class="card shadow-sm border-0 mb-4" style="border-radius: 16px;">
                            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                                <h5 class="font-weight-bold mb-0">Sự kiện chờ</h5>
                                <p class="text-muted small">Kéo sự kiện vào lịch để lưu</p>
                            </div>
                            <div class="card-body px-4 pb-4 pt-2">
                                <div id="external-events">
                                    <!-- Events will be loaded from local storage here -->
                                    <div class="text-center py-3 text-muted small" id="no-events-msg">
                                        Không có sự kiện chờ.
                                    </div>
                                </div>
                                <div class="custom-control custom-checkbox mt-3">
                                    <input type="checkbox" class="custom-control-input" id="drop-remove" checked>
                                    <label class="custom-control-label text-muted small" for="drop-remove">Xóa sau khi kéo</label>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Create Event Card -->
                        <div class="card shadow-sm border-0 quick-create-card" style="border-radius: 16px; transition: border-color 0.3s ease;">
                            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                                <h5 class="font-weight-bold mb-0">Lên lịch nhanh</h5>
                                <div class="badge badge-soft-primary" id="auto-save-status" style="display: none;">
                                    <i class="fas fa-sync fa-spin mr-1"></i> Đang lưu...
                                </div>
                            </div>
                            <div class="card-body px-4 pb-4 pt-2">
                                <div class="form-group mb-3">
                                    <label class="small text-muted">Tiêu đề cuộc họp</label>
                                    <input id="q-title" type="text" class="form-control" placeholder="Tên cuộc họp (tối thiểu 5 ký tự)...">
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label class="small text-muted">Thời gian bắt đầu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="far fa-calendar-alt"></i></span>
                                        </div>
                                        <input id="q-start" type="datetime-local" class="form-control border-left-0 q-input">
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="small text-muted">Thời gian kết thúc <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text bg-light border-right-0"><i class="far fa-clock"></i></span>
                                        </div>
                                        <input id="q-end" type="datetime-local" class="form-control border-left-0 q-input">
                                    </div>
                                </div>
 
                                <div class="form-group mb-3">
                                    <label class="small text-muted">Phòng họp <span class="text-danger">*</span></label>
                                    <select id="q-room" class="form-control q-input">
                                        <option value="">-- Chọn phòng họp --</option>
                                        @foreach (var room in ViewBag.Rooms) {
                                            <option value="@room.Id">@room.Name</option>
                                        }
                                    </select>
                                </div>
 
                                <div class="form-group mb-3">
                                    <label class="small text-muted">Hình thức <span class="text-danger">*</span></label>
                                    <select id="q-type" class="form-control q-input">
                                        <option value="1">Trực tiếp (Offline)</option>
                                        <option value="2">Trực tuyến (Online)</option>
                                    </select>
                                </div>
                                <div class="form-group mb-3" id="q-url-group" style="display: none;">
                                    <label class="small text-muted">URL cuộc họp</label>
                                    <input id="q-url" type="text" class="form-control q-input" placeholder="https://...">
                                </div>
 
                                @if (showFilters)
                                {
                                    <div class="form-group mb-3">
                                        <label class="small text-muted">Công ty <span class="text-danger">*</span></label>
                                        <select id="q-company" class="form-control q-input">
                                            <option value="">-- Chọn --</option>
                                            @foreach (var c in ViewBag.Companies) {
                                                <option value="@c.Id">@c.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group mb-3">
                                        <label class="small text-muted">Phòng ban <span class="text-danger">*</span></label>
                                        <select id="q-dept" class="form-control q-input">
                                            <option value="">-- Chọn --</option>
                                            @foreach (var d in ViewBag.Departments) {
                                                <option value="@d.Id" data-company-id="@d.CompanyId">@d.Name</option>
                                            }
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <input type="hidden" id="q-company" value="@userProfile?.CompanyId" />
                                    <input type="hidden" id="q-dept" value="@userProfile?.DepartmentId" />
                                }
                                
                                <div class="form-group mb-3">
                                    <label class="small text-muted mb-1">Màu sắc đánh dấu</label>
                                    <div class="d-flex gap-2" id="color-chooser">
                                        <button class="color-dot bg-primary active" data-color="#4f46e5"></button>
                                        <button class="color-dot bg-success" data-color="#10b981"></button>
                                        <button class="color-dot bg-warning" data-color="#f59e0b"></button>
                                        <button class="color-dot bg-danger" data-color="#ef4444"></button>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <button class="btn btn-light btn-sm text-muted" id="clear-q-form" title="Xóa form" style="border-radius: 8px;">
                                        <i class="fas fa-eraser"></i>
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-primary btn-sm px-3" id="add-to-draft" style="border-radius: 8px;" title="Lưu vào danh sách kéo thả">
                                            <i class="fas fa-layer-group mr-1"></i> Chờ
                                        </button>
                                        <button class="btn btn-primary btn-sm px-3" id="submit-q-form" style="border-radius: 8px; background: #4f46e5;">
                                            <i class="fas fa-check mr-1"></i> Lưu ngay
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Calendar Card -->
                <div class="col-lg-9">
                    <div class="card shadow-sm border-0" style="border-radius: 16px; overflow: hidden;">
                        <div class="card-body p-4">
                            <div id="calendar"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table View (Hidden by default) -->
        <div id="tableView" class="view-section d-none">
            <div class="table-container">
                <div class="table-header">
                    <div class="search-box">
                        <form method="get" id="filterForm" class="d-flex w-100 gap-3">
                            <div class="position-relative flex-grow-1">
                                <i class="fas fa-search"></i>
                                <input type="text" name="searchTerm" id="meetingSearch"
                                       placeholder="Tìm tên cuộc họp..."
                                       value="@ViewContext.HttpContext.Request.Query["searchTerm"]">
                            </div>
                        </form>
                    </div>
                </div>

                <div class="custom-table-wrapper table-responsive">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Cuộc họp</th>
                                <th>Thời gian</th>
                                <th>Địa điểm / Link</th>
                                <th class="text-right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="icon-box" style="background: #eef2ff; color: #4f46e5; width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                                                    <i class="fas fa-handshake"></i>
                                                </div>
                                                <div>
                                                    <div class="font-weight-600 text-main">@item.Title</div>
                                                    <div class="small text-muted">@item.DepartmentName - @item.CompanyName</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small">
                                                <i class="far fa-calendar-alt mr-1"></i> @item.StartAt.ToString("dd/MM/yyyy")<br />
                                                <i class="far fa-clock mr-1"></i> @item.StartAt.ToString("HH:mm") - @item.EndAt.ToString("HH:mm")
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Url))
                                            {
                                                <a href="@item.Url" target="_blank" class="badge badge-info p-2" style="border-radius: 6px;">
                                                    <i class="fas fa-video mr-1"></i> Tham gia online
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted"><i class="fas fa-map-marker-alt mr-1"></i> @item.RoomName</span>
                                            }
                                        </td>
                                        <td class="text-right">
                                            <div class="action-btns d-flex align-items-center justify-content-end gap-2">
                                                <!-- Nút Edit -->
                                                @if (item.CreatedBy == currentUserId || canEditOthers)
                                                {
                                                    <a asp-action="Update" asp-route-id="@item.Id" 
                                                    class="btn-icon btn-edit" 
                                                    title="Chỉnh sửa">
                                                        <i class="fas fa-pen"></i>
                                                    </a>

                                                    <!-- Nút Delete (giữ form để POST) -->
                                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" id="deleteForm-@item.Id"
                                                        style="margin: 0; display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="button" 
                                                                class="btn-icon btn-delete" 
                                                                title="Xóa"
                                                                onclick="confirmDeleteMeeting('@item.Id', '@item.Title')">
                                                            <i class="fas fa-trash-alt"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-light text-muted small"><i class="fas fa-lock mr-1"></i> Chỉ xem</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="text-muted">Không tìm thấy cuộc họp nào.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-footer">
                    @if (Model != null && Model.TotalRecords > 0)
                    {
                        var totalPages = (int)Math.Ceiling((double)Model.TotalRecords / Model.PageSize);
                        <div class="pagination-info">
                            Hiển thị <b>@Model.Items!.Count</b> trên tổng số <b>@Model.TotalRecords</b> cuộc họp
                        </div>
                        <div class="pagination-btns">
                            <a class="btn-page @(Model.PageNumber <= 1 ? "disabled" : "")" 
                               href="@Url.Action("Index", new { pageNumber = Model.PageNumber - 1, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"] })"
                               title="Trang trước">
                               <i class="fas fa-chevron-left"></i>
                            </a>
                            
                            @{
                                int startPage = Math.Max(1, Model.PageNumber - 2);
                                int endPage = Math.Min(totalPages, startPage + 4);
                                if (endPage - startPage < 4) startPage = Math.Max(1, endPage - 4);
                            }

                            @if (startPage > 1)
                            {
                                <a class="btn-page" href="@Url.Action("Index", new { pageNumber = 1, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"] })">1</a>
                                if (startPage > 2)
                                {
                                    <span class="btn-page disabled" style="border:none">...</span>
                                }
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <a class="btn-page @(i == Model.PageNumber ? "active" : "")" 
                                   href="@Url.Action("Index", new { pageNumber = i, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"] })">@i</a>
                            }

                            @if (endPage < totalPages)
                            {
                                if (endPage < totalPages - 1)
                                {
                                    <span class="btn-page disabled" style="border:none">...</span>
                                }
                                <a class="btn-page" href="@Url.Action("Index", new { pageNumber = totalPages, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"] })">@totalPages</a>
                            }
                            
                            <a class="btn-page @(Model.PageNumber >= totalPages ? "disabled" : "")" 
                               href="@Url.Action("Index", new { pageNumber = Model.PageNumber + 1, searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"] })"
                               title="Trang sau">
                               <i class="fas fa-chevron-right"></i>
                            </a>
                        </div>
                    }
                    else if (Model?.TotalRecords == 0)
                    {
                        <div class="pagination-info text-center w-100">
                            Không có dữ liệu để hiển thị
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Event Detail Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content" style="border-radius: 20px; border: none; box-shadow: 0 10px 40px rgba(0,0,0,0.1);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-weight-bold" id="eventTitleModal">Chi tiết cuộc họp</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-4 d-flex align-items-center gap-3">
                    <div id="modalIcon" class="icon-box" style="background: #eef2ff; color: #4f46e5; width: 50px; height: 50px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">
                        <i class="fas fa-handshake"></i>
                    </div>
                    <div>
                        <h4 id="displayEventTitle" class="font-weight-bold mb-0 text-main"></h4>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="small text-muted mb-1">Bắt đầu</label>
                        <div id="displayEventStart" class="font-weight-600 text-main"></div>
                    </div>
                    <div class="col-6">
                        <label class="small text-muted mb-1">Kết thúc</label>
                        <div id="displayEventEnd" class="font-weight-600 text-main"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-1">Phòng họp / Liên kết</label>
                    <div id="displayEventLocation" class="text-main"></div>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-1">Tổ chức</label>
                    <div id="displayEventOrg" class="text-main"></div>
                </div>

                <div class="mb-3">
                    <label class="small text-muted mb-1">Người tạo</label>
                    <div id="displayEventCreator" class="text-main font-weight-600"></div>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light px-4" data-dismiss="modal" style="border-radius: 10px;">Đóng</button>
                <a id="editEventBtn" href="#" class="btn btn-primary px-4" style="border-radius: 10px; background: #4f46e5; border: none;">Chỉnh sửa</a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <!-- FullCalendar CSS -->
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css' rel='stylesheet' />
    <link rel="stylesheet" href="~/css/index-meeting.css">
    <style>
        .event-blurred {
            opacity: 0.45 !important;
            filter: grayscale(0.4) !important;
            cursor: default !important;
            border-style: dashed !important;
        }
        .event-blurred .fc-event-title, .event-blurred .fc-event-time {
            font-weight: normal !important;
        }
    </style>
}

@section Scripts {
    <!-- FullCalendar JS & Draggable -->
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js'></script>
    <!-- SortableJS -->
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const currentUserId = '@currentUserId';
            const canEditOthers = @canEditOthers.ToString().ToLower();
            var Calendar = FullCalendar.Calendar;
            var Draggable = FullCalendar.Draggable;

            var containerEl = document.getElementById('external-events');
            var calendarEl = document.getElementById('calendar');
            var checkbox = document.getElementById('drop-remove');

            // --- LOCAL STORAGE LOGIC ---
            function loadDraftEvents() {
                const drafts = JSON.parse(localStorage.getItem('meetingDrafts') || '[]');
                const container = $('#external-events');
                container.find('.external-event').remove();
                
                if (drafts.length === 0) {
                    $('#no-events-msg').show();
                } else {
                    $('#no-events-msg').hide();
                    drafts.forEach((ev, index) => {
                        const eventEl = $('<div />')
                            .attr('data-id', index)
                            .attr('data-event', JSON.stringify({
                                title: ev.title,
                                backgroundColor: ev.color,
                                borderColor: ev.color,
                                extendedProps: ev
                            }))
                            .addClass('external-event')
                            .css({
                                'background-color': ev.color,
                                'border-color': ev.color,
                                'color': '#fff'
                            })
                            .html(`
                                <span>${ev.title}</span>
                                <button class="remove-draft" data-index="${index}" title="Xóa khỏi hàng đợi">
                                    <i class="fas fa-times"></i>
                                </button>
                            `);
                        container.append(eventEl);
                    });
                }
            }

            function saveDraftEvent(eventData) {
                const drafts = JSON.parse(localStorage.getItem('meetingDrafts') || '[]');
                drafts.push(eventData);
                localStorage.setItem('meetingDrafts', JSON.stringify(drafts));
                loadDraftEvents();
            }

            function removeDraftEvent(index) {
                const drafts = JSON.parse(localStorage.getItem('meetingDrafts') || '[]');
                drafts.splice(index, 1);
                localStorage.setItem('meetingDrafts', JSON.stringify(drafts));
                loadDraftEvents();
            }

            function resortDrafts() {
                const newDrafts = [];
                $('#external-events .external-event').each(function() {
                    const eventData = JSON.parse($(this).attr('data-event')).extendedProps;
                    newDrafts.push(eventData);
                });
                localStorage.setItem('meetingDrafts', JSON.stringify(newDrafts));
            }

            // Reload all data views (Calendar, List Table, and Stats)
            function refreshAllData() {
                // 1. Refresh Calendar Events
                if (typeof calendar !== 'undefined' && calendar) {
                    console.log('Refreshing calendar events...');
                    calendar.refetchEvents();
                }

                // 2. Refresh List View and Stats via AJAX
                const currentUrl = window.location.href;
                $.ajax({
                    url: currentUrl,
                    type: 'GET',
                    success: function (html) {
                        const $newHtml = $(html);

                        // Update table body
                        const newTbody = $newHtml.find('.custom-table tbody').html();
                        if (newTbody) {
                            $('.custom-table tbody').html(newTbody);
                        }

                        // Update stats grid (counters)
                        const newStats = $newHtml.find('.stats-grid').html();
                        if (newStats) {
                            $('.stats-grid').html(newStats);
                        }

                        // Update footer (pagination info)
                        const newFooter = $newHtml.find('.table-footer').html();
                        if (newFooter) {
                            $('.table-footer').html(newFooter);
                        }

                        console.log('Synchronized List View and Stats');
                    },
                    error: function (xhr) {
                        console.error('Failed to synchronize views:', xhr);
                    }
                });
            }

            // Delete draft handler
            $(document).on('click', '.remove-draft', function(e) {
                e.preventDefault();
                e.stopPropagation(); // Prevent drag start
                const index = $(this).data('index');
                Swal.fire({
                    title: 'Xóa sự kiện chờ?',
                    text: "Sự kiện này sẽ bị gỡ khỏi hàng đợi.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#ef4444',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: 'Xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        removeDraftEvent(index);
                    }
                });
            });

            // Initialize Sortable
            new Sortable(containerEl, {
                animation: 150,
                ghostClass: 'sortable-ghost',
                onEnd: function() {
                    resortDrafts();
                    loadDraftEvents(); // Reload to refresh data-index
                }
            });

            // Initialize Draggable
            new Draggable(containerEl, {
                itemSelector: '.external-event',
                eventData: function (eventEl) {
                    return JSON.parse(eventEl.getAttribute('data-event'));
                }
            });

            // Color Chooser Logic
            var currColor = localStorage.getItem('meetingPreferredColor') || '#4f46e5';
            
            function applyQuickColor(color) {
                currColor = color;
                localStorage.setItem('meetingPreferredColor', color);
                $('#color-chooser > button').removeClass('active');
                const $activeBtn = $(`#color-chooser > button[data-color="${color}"]`);
                if ($activeBtn.length) {
                    $activeBtn.addClass('active');
                } else {
                    $('#color-chooser > button.bg-primary').addClass('active');
                }
                
                // Visual feedback
                $('.quick-create-card').css('border-top-color', color);
                $('#submit-q-form').css('background-color', color).css('border-color', color);
                document.documentElement.style.setProperty('--active-color', color);
            }

            // Sync UI on load
            applyQuickColor(currColor);

            $('#color-chooser > button').click(function () {
                applyQuickColor($(this).data('color'));
            });

            // --- DEPARTMENT FILTERING ---
            const $companySelect = $('#q-company');
            const $deptSelect = $('#q-dept');
            
            if ($companySelect.is('select') && $deptSelect.is('select')) {
                const $deptOptions = $deptSelect.find('option').clone();

                $companySelect.change(function() {
                const companyId = $(this).val();
                const currentDept = $deptSelect.val();
                
                $deptSelect.empty();
                // Always keep the placeholder
                $deptSelect.append($deptOptions.filter('[value=""]'));
                
                if (companyId) {
                    $deptOptions.filter(function() {
                        return $(this).data('company-id') == companyId;
                    }).appendTo($deptSelect);
                } else {
                    // If no company selected, show all departments
                    $deptOptions.filter('[value!=""]').appendTo($deptSelect);
                }
                
                if (currentDept && $deptSelect.find(`option[value="${currentDept}"]`).length > 0) {
                    $deptSelect.val(currentDept);
                }
            });
        }

            // Handle Type toggle in Quick Create
            $('#q-type').change(function() {
                if ($(this).val() == '2') { // ONLINE
                    $('#q-url-group').slideDown(200);
                } else {
                    $('#q-url-group').slideUp(200);
                    $('#q-url').val('');
                }
            });

            // --- QUICK CREATE LOGIC ---
            let isCreating = false;

            function submitQuickMeeting(silent = false) {
                if (isCreating) return;

                const title = $('#q-title').val();
                const startAt = $('#q-start').val();
                const endAt = $('#q-end').val();
                const roomId = $('#q-room').val();
                const companyId = $('#q-company').val();
                const departmentId = $('#q-dept').val();
                const type = $('#q-type').val();
                const url = $('#q-url').val();

                // Validation for auto-save (must be silent and have all data)
                if (silent && (!title || title.length < 5 || !startAt || !endAt || !roomId || !companyId || !departmentId)) {
                    return; 
                }

                // Explicit validation for manual save
                if (!silent && (!title || title.length < 5 || !startAt || !endAt || !roomId || !companyId || !departmentId)) {
                    Swal.fire({
                        title: 'Thông tin chưa đủ',
                        text: 'Vui lòng nhập tiêu đề (>= 5 ký tự) và chọn đầy đủ các trường bắt đầu, kết thúc, phòng, công ty, phòng ban.',
                        icon: 'warning',
                        confirmButtonColor: '#4f46e5'
                    });
                    return;
                }

                // Check time sequence
                if (moment(endAt).isBefore(moment(startAt))) {
                    if (!silent) Swal.fire('Lỗi thời gian', 'Thời gian kết thúc phải sau thời gian bắt đầu.', 'error');
                    return;
                }

                isCreating = true;
                if (silent) $('#auto-save-status').fadeIn();

                const model = {
                    Title: title,
                    StartAt: moment(startAt).format('YYYY-MM-DDTHH:mm:ss'),
                    EndAt: moment(endAt).format('YYYY-MM-DDTHH:mm:ss'),
                    RoomId: roomId,
                    CompanyId: companyId,
                    DepartmentId: departmentId,
                    Color: currColor,
                    Type: type,
                    Url: url,
                    RowStatus: 1 // ACTIVE
                };

                $.ajax({
                    url: '/Meeting/Create',
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    data: model,
                    success: function (response) {
                        if (response.success) {
                            Toast.fire({
                                icon: 'success',
                                title: silent ? 'Đã tự động lên lịch' : 'Đã tạo cuộc họp thành công'
                            });
                            
                            clearQuickForm();
                            refreshAllData();
                        } else {
                            if (!silent) Swal.fire('Không thể lưu', response.message, 'error');
                        }
                    },
                    error: function() {
                        if (!silent) Swal.fire('Lỗi kết nối', 'Không thể kết nối đến máy chủ. Vui lòng thử lại.', 'error');
                    },
                    complete: function() {
                        isCreating = false;
                        $('#auto-save-status').fadeOut();
                    }
                });
            }

            function clearQuickForm() {
                $('.q-input, #q-input, #q-title').val('');
                applyQuickColor(localStorage.getItem('meetingPreferredColor') || '#4f46e5');
            }

            // Bind events for auto-save and manual triggers
            $('.q-input, #q-title').on('change input', function() {
                clearTimeout(window.autoSaveTimer);
                window.autoSaveTimer = setTimeout(() => {
                    submitQuickMeeting(true); 
                }, 2000); // 2 second delay for auto-save
            });

            $('#submit-q-form').click(() => submitQuickMeeting(false));
            $('#clear-q-form').click(clearQuickForm);

            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });

            // Add to Draft Button
            $('#add-to-draft').click(function () {
                const title = $('#q-title').val();
                if (!title || title.length < 5) {
                    Swal.fire('Chú ý', 'Vui lòng nhập tiêu đề ít nhất 5 ký tự', 'warning');
                    return;
                }

                const eventData = {
                    title: title,
                    startTime: $('#q-start').val() ? moment($('#q-start').val()).format('HH:mm') : '',
                    endTime: $('#q-end').val() ? moment($('#q-end').val()).format('HH:mm') : '',
                    roomId: $('#q-room').val(),
                    companyId: $('#q-company').val(),
                    departmentId: $('#q-dept').val(),
                    type: $('#q-type').val(),
                    url: $('#q-url').val(),
                    color: currColor
                };

                saveDraftEvent(eventData);
                clearQuickForm();
                Toast.fire({ icon: 'success', title: 'Đã lưu vào danh sách chờ' });
            });

            // --- CALENDAR LOGIC ---
            var calendar = new Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'vi',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                editable: true,
                droppable: true,
                events: '/Meeting/GetCalendarEvents',
                eventDidMount: function(info) {
                    // Add tooltip and custom styling to events
                    const props = info.event.extendedProps;
                    const canEdit = props.createdBy === currentUserId || canEditOthers;
                    const creator = props.createdBy ? `<br/>ID Người tạo: ${props.createdBy}` : '';
                    const tooltipContent = `<strong>${info.event.title}</strong><br/>Phòng: ${props.room || 'N/A'}<br/>Công ty: ${props.company || 'N/A'}${creator} ${!canEdit ? '<br/>(Chỉ xem)' : ''}`;
                    
                    $(info.el).css('cursor', canEdit ? 'pointer' : 'default');

                    if (!canEdit) {
                        $(info.el).addClass('event-blurred');
                    }
                    
                    // Force the color again if needed (FullCalendar handles it but just in case)
                    if (props.color) {
                        $(info.el).css('background-color', props.color);
                        $(info.el).css('border-color', props.color);
                    }
                    
                    // Initialize bootstrap tooltip
                    $(info.el).tooltip({
                        title: tooltipContent,
                        html: true,
                        placement: 'top',
                        trigger: 'hover',
                        container: 'body'
                    });
                },
                eventWillUnmount: function(info) {
                    $(info.el).tooltip('dispose');
                },

                // When an existing event is dropped (rescheduled)
                eventDrop: function(info) {
                    if (info.event.extendedProps.createdBy !== currentUserId && !canEditOthers) {
                        Swal.fire('Quyền hạn', 'Bạn không thể dời lịch họp của người khác!', 'warning');
                        info.revert();
                        return;
                    }
                    const evt = info.event;
                    $.ajax({
                        url: '/Meeting/Reschedule',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            id: evt.id,
                            startAt: moment(evt.start).format('YYYY-MM-DDTHH:mm:ss'),
                            endAt: moment(evt.end).format('YYYY-MM-DDTHH:mm:ss')
                        }),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Cuộc họp đã được di chuyển',
                                    showConfirmButton: false,
                                    timer: 2000
                                });
                                refreshAllData();
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                                info.revert();
                            }
                        },
                        error: function(xhr) {
                            Swal.fire('Lỗi', 'Không thể cập nhật lịch', 'error');
                            info.revert();
                        }
                    });
                },
                
                // When an existing event is resized (duration changed)
                eventResize: function(info) {
                    if (info.event.extendedProps.createdBy !== currentUserId && !canEditOthers) {
                        Swal.fire('Quyền hạn', 'Bạn không thể thay đổi thời lượng họp của người khác!', 'warning');
                        info.revert();
                        return;
                    }
                    const evt = info.event;
                    $.ajax({
                        url: '/Meeting/Reschedule',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            id: evt.id,
                            startAt: moment(evt.start).format('YYYY-MM-DDTHH:mm:ss'),
                            endAt: moment(evt.end).format('YYYY-MM-DDTHH:mm:ss')
                        }),
                        success: function(res) {
                            if (res.success) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Đã thay đổi thời lượng cuộc họp',
                                    showConfirmButton: false,
                                    timer: 2000
                                });
                                refreshAllData();
                            } else {
                                Swal.fire('Lỗi', res.message, 'error');
                                info.revert();
                            }
                        },
                        error: function() {
                            Swal.fire('Lỗi', 'Không thể cập nhật thời lượng', 'error');
                            info.revert();
                        }
                    });
                },
                
                // When an external event is dropped
                drop: function (info) {
                    const eventData = JSON.parse(info.draggedEl.getAttribute('data-event')).extendedProps;
                    const dropDate = moment(info.date);
                    
                    // Construct start/end times based on drop date and pre-set times
                    let startAt = dropDate.clone();
                    if (eventData.startTime) {
                        const [h, m] = eventData.startTime.split(':');
                        startAt.hour(h).minute(m);
                    }
                    
                    let endAt = startAt.clone().add(1, 'hours');
                    if (eventData.endTime) {
                        const [h, m] = eventData.endTime.split(':');
                        endAt.hour(h).minute(m);
                    }

                    // Prepare Model for Creating in DB
                    const model = {
                        Title: eventData.title,
                        StartAt: startAt.format('YYYY-MM-DDTHH:mm:ss'),
                        EndAt: endAt.format('YYYY-MM-DDTHH:mm:ss'),
                        RoomId: eventData.roomId,
                        CompanyId: eventData.companyId,
                        DepartmentId: eventData.departmentId,
                        Color: eventData.color || currColor, // Use the color from draft or current active color
                        Type: eventData.type || 1, 
                        Url: eventData.url || '',
                        RowStatus: 1 // ACTIVE (RowStatus.ACTIVE = 1)
                    };

                    // Sync to Database
                    $.ajax({
                        url: '/Meeting/Create',
                        method: 'POST',
                        data: model,
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: response.message,
                                    showConfirmButton: false,
                                    timer: 3000
                                });
                                
                                // Refetch events with a small delay to ensure DB is updated
                                setTimeout(() => {
                                    refreshAllData();
                                }, 500);
                                
                                if (checkbox.checked) {
                                    const index = $(info.draggedEl).data('id');
                                    removeDraftEvent(index);
                                }
                            } else {
                                Swal.fire('Thất bại', response.message, 'error');
                                // Remove the event if it was added locally but rejected by server
                                const event = calendar.getEventById(info.draggedEl.getAttribute('data-id'));
                                if (event) event.remove();
                            }
                        },
                        error: function (xhr) {
                            let errMsg = 'Không thể lưu cuộc họp';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errMsg = xhr.responseJSON.message;
                            } else if (xhr.status === 0) {
                                errMsg = 'Mất kết nối mạng. Vui lòng kiểm tra và thử lại.';
                            }
                            
                            Swal.fire('Lỗi hệ thống', errMsg, 'error');
                            
                            // Remove the event from calendar if request failed
                            const event = calendar.getEventById(info.draggedEl.getAttribute('data-id'));
                            if (event) event.remove();
                            
                            console.error('Meeting Create Error:', xhr);
                        }
                    });
                },

                eventClick: function(info) {
                    info.jsEvent.preventDefault();
                    const event = info.event;
                    const props = event.extendedProps;
                    
                    // Format dates for display
                    const startStr = moment(event.start).format('DD/MM/YYYY, HH:mm');
                    let endStr = 'N/A';
                    if (event.end) {
                        endStr = moment(event.end).format('DD/MM/YYYY, HH:mm');
                    } else if (props.endAt) {
                        endStr = moment(props.endAt).format('DD/MM/YYYY, HH:mm');
                    }

                    document.getElementById('displayEventTitle').textContent = event.title;
                    document.getElementById('displayEventStart').textContent = startStr;
                    document.getElementById('displayEventEnd').textContent = endStr;
                    document.getElementById('displayEventLocation').innerHTML = event.url ? `<a href="${event.url}" target="_blank">${event.url}</a>` : (props.room || 'N/A');
                    document.getElementById('displayEventOrg').textContent = props.department ? `${props.department} - ${props.company}` : 'N/A';
                    
                    // Show creator if available
                    const creatorEl = document.getElementById('displayEventCreator');
                    if (creatorEl) {
                        creatorEl.textContent = props.createdBy || 'N/A';
                    }

                    document.getElementById('editEventBtn').href = `/Meeting/Update/${event.id}`;
                    
                    // Permission Check
                    if (props.createdBy === currentUserId || canEditOthers) {
                        document.getElementById('editEventBtn').style.display = 'inline-block';
                    } else {
                        document.getElementById('editEventBtn').style.display = 'none';
                    }

                    $('#eventModal').modal('show');
                }
            });

            calendar.render();
            loadDraftEvents();

            // Refresh Calendar Button Handler
            $('#refreshCalendarBtn').click(function() {
                const btn = $(this);
                const icon = btn.find('i');
                
                btn.prop('disabled', true);
                icon.addClass('fa-spin');
                
                console.log('Manual refresh triggered');
                refreshAllData();
                
                setTimeout(() => {
                    btn.prop('disabled', false);
                    icon.removeClass('fa-spin');
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Đã làm mới lịch',
                        showConfirmButton: false,
                        timer: 2000
                    });
                }, 1000);
            });

            // View Toggle Logic
            $('#toggleViewBtn').click(function () {
                if ($('#calendarView').hasClass('d-none')) {
                    $('#calendarView').removeClass('d-none');
                    $('#tableView').addClass('d-none');
                    $('#toggleText').text('Chế độ Danh sách');
                    $(this).find('i').attr('class', 'fas fa-list mr-1');
                    localStorage.setItem('meetingViewMode', 'calendar');
                    calendar.render();
                } else {
                    $('#calendarView').addClass('d-none');
                    $('#tableView').removeClass('d-none');
                    $('#toggleText').text('Chế độ Lịch biểu');
                    $(this).find('i').attr('class', 'fas fa-calendar-alt mr-1');
                    localStorage.setItem('meetingViewMode', 'list');
                }
            });

            // Restore saved view mode on load
            const savedView = localStorage.getItem('meetingViewMode');
            if (savedView === 'list') {
                $('#calendarView').addClass('d-none');
                $('#tableView').removeClass('d-none');
                $('#toggleText').text('Chế độ Lịch biểu');
                $('#toggleViewBtn').find('i').attr('class', 'fas fa-calendar-alt mr-1');
            }
        });

        function confirmDeleteMeeting(id, title) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn có chắc chắn muốn xóa cuộc họp "${title}" không? Hành động này không thể hoàn tác.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.getElementById('deleteForm-' + id);
                    if (form) {
                        form.submit();
                    }
                }
            });
        }
    </script>
}