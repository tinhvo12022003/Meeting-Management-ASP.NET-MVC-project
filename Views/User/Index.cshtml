@using MeetingManagement.Common
@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model PaginatedResponse<UserViewModel>

@{
    ViewData["Title"] = "Quản lý Người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="page-header">
        <div class="header-title">
            <h3>Quản lý Người dùng</h3>
            @* <p class="text-muted small">Quản lý tài khoản và quyền hạn nhân viên</p> *@
        </div>
        <div class="header-actions">
            <a asp-action="Register" class="btn-header btn-header-primary">
                <i class="fas fa-plus"></i> Thêm người dùng
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background: #eef2ff; color: #4f46e5;">
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <span class="label">Tổng số người dùng</span>
                <span class="value">@Model.TotalRecords</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #f0fdf4; color: #16a34a;">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="stat-content">
                <span class="label">Quản trị viên</span>
                <span class="value">@Model.Items.Count(x => x.userType == UserType.ADMIN)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fff7ed; color: #ea580c;">
                <i class="fas fa-user-tie"></i>
            </div>
            <div class="stat-content">
                <span class="label">Quản lý bộ phận</span>
                <span class="value">@Model.Items.Count(x => x.userType == UserType.MANAGER)</span>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background: #fdf2f8; color: #db2777;">
                <i class="fas fa-user-tag"></i>
            </div>
            <div class="stat-content">
                <span class="label">Nhân viên</span>
                <span class="value">@Model.Items.Count(x => x.userType == UserType.STAFF)</span>
            </div>
        </div>
    </div>

    <!-- Users Table Section -->
    <div class="table-container">
        <div class="table-header">
            <div class="filter-box w-100">
                <form method="get" id="filterForm" class="row g-3 align-items-center">
                    <div class="col-lg-4 col-md-6 position-relative">
                        <div class="search-input-wrapper">
                            <i class="fas fa-search search-icon"></i>
                            <input type="text" name="searchTerm" id="userSearch" class="form-control"
                                   placeholder="Tìm tên, email hoặc tên đăng nhập..."
                                   value="@ViewContext.HttpContext.Request.Query["searchTerm"]">
                        </div>
                    </div>
                    
                    <div class="col-lg-3 col-md-6">
                        <select name="companyId" id="companyFilter" class="form-control custom-select" onchange="this.form.submit()">
                            <option value="">-- Tất cả công ty --</option>
                            @if (ViewBag.Companies != null)
                            {
                                foreach (var company in (IEnumerable<CompanyViewModel>)ViewBag.Companies)
                                {
                                    if (ViewBag.SelectedCompanyId == company.Id)
                                    {
                                        <option value="@company.Id" selected>@company.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@company.Id">@company.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <select name="departmentId" id="departmentFilter" class="form-control custom-select" onchange="this.form.submit()">
                            <option value="">-- Tất cả phòng ban --</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in (IEnumerable<DepartmentViewModel>)ViewBag.Departments)
                                {
                                    if (ViewBag.SelectedDepartmentId == dept.Id)
                                    {
                                        <option value="@dept.Id" selected>@dept.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@dept.Id">@dept.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <div class="d-flex gap-2">
                            @* <button type="submit" class="btn btn-primary w-100" style="background: #4f46e5; border: none; border-radius: 8px;">
                                <i class="fas fa-filter mr-1"></i> Lọc
                            </button> *@
                            @if (!string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["searchTerm"]) || 
                                 !string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["companyId"]) || 
                                 !string.IsNullOrEmpty(ViewContext.HttpContext.Request.Query["departmentId"]))
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary" style="border-radius: 8px;" title="Xóa bộ lọc">
                                    <i class="fas fa-times"></i>
                                </a>
                            }
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="custom-table-wrapper table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Người dùng</th>
                        <th>Thông tin liên hệ</th>
                        <th>Phòng ban / Công ty</th>
                        <th>Vai trò</th>
                        <th class="text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar" 
                                             style="background-image: url('https://ui-avatars.com/api/?name=@item.FullName&background=random&color=fff');">
                                        </div>
                                        <div class="user-info">
                                            <span class="name">@item.FullName</span>
                                            @* <span class="username">@@@item.Username</span> *@
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="contact-info">
                                        <span class="email d-block"><i class="far fa-envelope mr-1 text-muted"></i> @item.Email</span>
                                        <span class="phone d-block"><i class="fas fa-phone-alt mr-1 text-muted"></i> @item.Phone</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="org-info">
                                        <span class="dept">@item.DepartmentName</span>
                                        <span class="company text-muted small d-block">@item.CompanyName</span>
                                    </div>
                                </td>
                                <td>
                                    @{
                                        var badgeClass = item.userType switch {
                                            UserType.ADMIN => "badge-admin",
                                            UserType.MANAGER => "badge-head",
                                            _ => "badge-staff"
                                        };
                                        var typeLabel = item.userType switch {
                                            UserType.ADMIN => "Quản trị viên",
                                            UserType.MANAGER => "Quản lý bộ phận",
                                            _ => "Nhân viên"
                                        };
                                    }
                                    <span class="badge-role @badgeClass">@typeLabel</span>
                                </td>
                                <td>
                                    <div class="action-btns justify-content-end">
                                        <a asp-controller="Auth" asp-action="Authorized" asp-route-userId="@item.Id" class="btn-icon btn-permission" title="Phân quyền">
                                            <i class="fas fa-shield-alt"></i>
                                        </a>
                                        <a asp-action="Update" asp-route-id="@item.Id" class="btn-icon btn-edit" title="Chỉnh sửa">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <form asp-action="Delete" method="post" id="deleteForm-@item.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@item.Id" />
                                            <button type="button" class="btn-icon btn-delete" title="Xóa" onclick="confirmDelete('@item.Id', '@item.FullName')">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">Không tìm thấy người dùng nào phù hợp.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            <div class="pagination-info">
                Hiển thị <b>@Model?.Items?.Count</b> trên tổng số <b>@Model?.TotalRecords</b> người dùng
            </div>
            <div class="pagination-btns">
                <a class="btn-page @(Model?.PageNumber <= 1 ? "disabled" : "")" 
                   href="@Url.Action("Index", new { 
                       pageNumber = Model?.PageNumber - 1, 
                       searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"],
                       companyId = ViewContext.HttpContext.Request.Query["companyId"],
                       departmentId = ViewContext.HttpContext.Request.Query["departmentId"]
                   })">
                   <i class="fas fa-chevron-left"></i>
                </a>
                
                @for (int i = 1; i <= Math.Ceiling((double)Model.TotalRecords / Model.PageSize); i++)
                {
                    <a class="btn-page @(i == Model.PageNumber ? "active" : "")" 
                       href="@Url.Action("Index", new { 
                           pageNumber = i, 
                           searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"],
                           companyId = ViewContext.HttpContext.Request.Query["companyId"],
                           departmentId = ViewContext.HttpContext.Request.Query["departmentId"]
                       })">@i</a>
                }
                
                <a class="btn-page @(Model.PageNumber >= Math.Ceiling((double)Model.TotalRecords / Model.PageSize) ? "disabled" : "")" 
                   href="@Url.Action("Index", new { 
                       pageNumber = Model.PageNumber + 1, 
                       searchTerm = ViewContext.HttpContext.Request.Query["searchTerm"],
                       companyId = ViewContext.HttpContext.Request.Query["companyId"],
                       departmentId = ViewContext.HttpContext.Request.Query["departmentId"]
                   })">
                   <i class="fas fa-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/index-user.css">
}

@section Scripts {
    <script>
        $(document).ready(function() {
            var successMsg = '@TempData["Success"]';
            var errorMsg = '@TempData["Error"]';
            
            if (successMsg) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: successMsg,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
            
            if (errorMsg) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: errorMsg,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }
        });

        function confirmDelete(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa?',
                text: `Bạn có chắc chắn muốn xóa người dùng "${name}"? Thao tác này không thể hoàn tác.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = document.getElementById('deleteForm-' + id);
                    if (form) {
                        form.submit();
                    }
                }
            });
        }
    </script>
}
