@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model UserUpdateModel

@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11 col-xl-10">
            <!-- Header section with Glassmorphism effect -->
            <div class="profile-header mb-4 p-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="avatar-wrapper mr-4">
                        <div class="avatar-lg bg-primary text-white d-flex align-items-center justify-content-center rounded-circle shadow">
                            <i class="fas fa-user fa-3x"></i>
                        </div>
                        @* <button class="btn btn-sm btn-light rounded-circle edit-avatar-btn shadow-sm">
                            <i class="fas fa-camera"></i>
                        </button> *@
                    </div>
                    <div>
                        <h2 class="font-weight-bold mb-1 text-white">@Model.FullName</h2>
                        <p class="mb-0 text-white-50">
                            <i class="fas fa-briefcase mr-2"></i> 
                            @(Model.UserType switch { 
                                UserType.ADMIN => "Quản trị viên", 
                                UserType.MANAGER => "Quản lý bộ phận", 
                                _ => "Nhân viên" 
                            })
                        </p>
                    </div>
                </div>
                <div class="text-right d-none d-md-block">
                    <span class="badge badge-pill badge-light px-3 py-2">
                        <i class="fas fa-check-circle text-success mr-1"></i> Tài khoản đã xác thực
                    </span>
                </div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px;">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm alert-dismissible fade show mb-4" role="alert" style="border-radius: 12px;">
                    <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
            }

            <form asp-action="Profile" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Username" />
                <input type="hidden" asp-for="UserType" />
                <input type="hidden" asp-for="CompanyId" />
                <input type="hidden" asp-for="DepartmentId" />

                <div class="row">
                    <!-- Left Column: Primary Information -->
                    <div class="col-md-8 mb-4">
                        <div class="card border-0 shadow-sm h-100 overflow-hidden" style="border-radius: 20px;">
                            <div class="card-header bg-white py-3 border-0">
                                <h5 class="mb-0 font-weight-bold"><i class="fas fa-id-card text-primary mr-2"></i>Thông tin cơ bản</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="row">
                                    <div class="col-md-12 mb-4">
                                        <label asp-for="FullName" class="custom-label">Họ và tên</label>
                                        <div class="input-group input-rounded">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-user"></i></span>
                                            </div>
                                            <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên đầy đủ">
                                        </div>
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Email" class="custom-label">Email công việc</label>
                                        <div class="input-group input-rounded">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-envelope"></i></span>
                                            </div>
                                            <input asp-for="Email" type="email" class="form-control" placeholder="example@company.com">
                                        </div>
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Phone" class="custom-label">Số điện thoại</label>
                                        <div class="input-group input-rounded">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-phone-alt"></i></span>
                                            </div>
                                            <input asp-for="Phone" class="form-control" placeholder="090x xxx xxx">
                                        </div>
                                        <span asp-validation-for="Phone" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Birthday" class="custom-label">Ngày sinh</label>
                                        <div class="input-group input-rounded">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="far fa-calendar"></i></span>
                                            </div>
                                            <input asp-for="Birthday" type="date" class="form-control">
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-4">
                                        <label asp-for="Gender" class="custom-label">Giới tính</label>
                                        <div class="input-group input-rounded">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-venus-mars"></i></span>
                                            </div>
                                            <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-control custom-select">
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-12 mb-0">
                                        <label asp-for="Address" class="custom-label">Địa chỉ liên hệ</label>
                                        <div class="input-group input-rounded">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                            </div>
                                            <input asp-for="Address" class="form-control" placeholder="Số nhà, tên đường, quận/huyện, tỉnh/thành phố">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Secondary Information & Security -->
                    <div class="col-md-4">
                        <!-- <div class="card border-0 shadow-sm mb-4" style="border-radius: 20px;">
                            <div class="card-header bg-white py-3 border-0">
                                <h5 class="mb-0 font-weight-bold"><i class="fas fa-shield-alt text-primary mr-2"></i>Bảo mật</h5>
                            </div>
                            <div class="card-body p-4">
                                <p class="small text-muted mb-4">Để trống nếu không muốn thay đổi mật khẩu hiện tại.</p>
                                
                                <div class="form-group mb-3">
                                    <label asp-for="PlainPassword" class="custom-label">Mật khẩu mới</label>
                                    <input asp-for="PlainPassword" type="password" class="form-control input-rounded-simple" placeholder="********">
                                </div>
                                <div class="form-group mb-0">
                                    <label asp-for="ConfirmPlainPassword" class="custom-label">Xác nhận mật khẩu</label>
                                    <input asp-for="ConfirmPlainPassword" type="password" class="form-control input-rounded-simple" placeholder="********">
                                </div>
                                <span asp-validation-for="ConfirmPlainPassword" class="text-danger small"></span>
                            </div>
                        </div> -->

                        <div class="card border-0 shadow-sm bg-light" style="border-radius: 20px;">
                            <div class="card-header bg-transparent py-3 border-0">
                                <h5 class="mb-0 font-weight-bold text-muted"><i class="fas fa-building mr-2"></i>Tổ chức</h5>
                            </div>
                            <div class="card-body p-4">
                                <div class="info-item mb-3">
                                    <label class="custom-label-static mb-1">Tên đăng nhập</label>
                                    <div class="font-weight-bold text-dark">@@@Model.Username</div>
                                </div>
                                <div class="info-item mb-3">
                                    <label class="custom-label-static mb-1">Phòng ban</label>
                                    <div class="text-dark">@(ViewBag.Departments != null ? ((IEnumerable<DepartmentViewModel>)ViewBag.Departments).FirstOrDefault(d => d.Id == Model.DepartmentId)?.Name : "N/A")</div>
                                </div>
                                <div class="info-item">
                                    <label class="custom-label-static mb-1">Công ty</label>
                                    <div class="text-dark">@(ViewBag.Companies != null ? ((IEnumerable<CompanyViewModel>)ViewBag.Companies).FirstOrDefault(c => c.Id == Model.CompanyId)?.Name : "N/A")</div>
                                </div>
                                <div class="mt-4 p-3 bg-white" style="border-radius: 12px; border-left: 4px solid #4f46e5;">
                                    <p class="small text-muted mb-0">Thông tin tổ chức được quản lý bởi Quản trị viên hệ thống.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-link text-muted" onclick="window.history.back()">
                        <i class="fas fa-chevron-left mr-2"></i> Quay lại
                    </button>
                    <button type="submit" class="btn btn-save px-5 py-3 shadow-lg">
                        <i class="fas fa-save mr-2"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/profile-user.css">
}

