@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model UserCreateModel

@{
    ViewData["Title"] = "Thêm mới Người dùng";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-light btn-sm rounded-circle mr-3 shadow-sm back-btn">
                        <i class="fas fa-arrow-left text-muted"></i>
                    </a>
                    <div>
                        <h3 class="font-weight-bold mb-0">Tạo tài khoản mới</h3>
                        <p class="text-muted small mb-0">Thiết lập thông tin định danh và phân quyền cho nhân sự mới.</p>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm main-card">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Register" method="post">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" style="border-radius: 12px;"></div>
                        }

                        <div class="row">
                            <!-- Left Column: Security & Role -->
                            <div class="col-md-5 border-right-md pr-md-4">
                                <div class="section-title mb-4">
                                    <span class="badge badge-soft-primary px-3 py-2">Bảo mật & Phân quyền</span>
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label asp-for="Username" class="custom-label">Tên đăng nhập <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-user-circle"></i></span>
                                        </div>
                                        <input asp-for="Username" class="form-control" placeholder="Ví dụ: nva_123" required />
                                    </div>
                                    <span asp-validation-for="Username" class="text-danger small"></span>
                                </div>
                                
                                <div class="form-group mb-3">
                                    <label asp-for="UserType" class="custom-label">Vai trò hệ thống</label>
                                    <select asp-for="UserType" asp-items="Html.GetEnumSelectList<UserType>()" class="form-control custom-select">
                                    </select>
                                    <span asp-validation-for="UserType" class="text-danger small"></span>
                                </div>

                                <div class="p-4 bg-light" style="border-radius: 15px; border: 1px dashed #cbd5e1;">
                                    <div class="form-group mb-3">
                                        <label asp-for="PlainPassword" class="custom-label">Mật khẩu ban đầu <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                            </div>
                                            <input asp-for="PlainPassword" type="password" class="form-control" placeholder="••••••••" required />
                                        </div>
                                        <span asp-validation-for="PlainPassword" class="text-danger small"></span>
                                    </div>

                                    <div class="form-group mb-0">
                                        <label asp-for="ConfirmPlainPassword" class="custom-label">Xác nhận mật khẩu <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                            </div>
                                            <input asp-for="ConfirmPlainPassword" type="password" class="form-control" placeholder="••••••••" required />
                                        </div>
                                        <span asp-validation-for="ConfirmPlainPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Column: Personal & Organization -->
                            <div class="col-md-7 pl-md-4 mt-4 mt-md-0">
                                <div class="section-title mb-4">
                                    <span class="badge badge-soft-success px-3 py-2">Thông tin nhân sự</span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FullName" class="custom-label">Họ và tên <span class="text-danger">*</span></label>
                                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" required>
                                        <span asp-validation-for="FullName" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Email" class="custom-label">Email công vụ <span class="text-danger">*</span></label>
                                        <input asp-for="Email" type="email" class="form-control" placeholder="example@@company.com" required>
                                        <span asp-validation-for="Email" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Phone" class="custom-label">Điện thoại</label>
                                        <input asp-for="Phone" class="form-control" placeholder="090...">
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="Gender" class="custom-label">Giới tính</label>
                                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-control custom-select"></select>
                                    </div>
                                    <div class="col-md-3 mb-3">
                                        <label asp-for="Birthday" class="custom-label">Ngày sinh</label>
                                        <input asp-for="Birthday" type="date" class="form-control">
                                    </div>
                                </div>

                                <div class="form-group mb-3">
                                    <label asp-for="Address" class="custom-label">Địa chỉ liên hệ</label>
                                    <input asp-for="Address" class="form-control" placeholder="Văn phòng, số nhà...">
                                </div>

                                <div class="section-title mb-4 mt-4">
                                    <span class="badge badge-soft-warning px-3 py-2">Tổ chức & Công tác</span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="CompanyId" class="custom-label">Công ty <span class="text-danger">*</span></label>
                                        <select asp-for="CompanyId" id="companySelect" class="form-control custom-select" required>
                                            <option value="">-- Chọn công ty --</option>
                                            @if (ViewBag.Companies != null)
                                            {
                                                foreach (var c in (IEnumerable<CompanyViewModel>)ViewBag.Companies)
                                                {
                                                    <option value="@c.Id">@c.Name</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="CompanyId" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="DepartmentId" class="custom-label">Phòng ban <span class="text-danger">*</span></label>
                                        <select asp-for="DepartmentId" id="deptSelect" class="form-control custom-select" required>
                                            <option value="">-- Chọn phòng ban --</option>
                                            @if (ViewBag.Departments != null)
                                            {
                                                foreach (var d in (IEnumerable<DepartmentViewModel>)ViewBag.Departments)
                                                {
                                                    <option value="@d.Id">@d.Name</option>
                                                }
                                            }
                                        </select>
                                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4 opacity-1">

                        <div class="d-flex justify-content-end align-items-center">
                            <a asp-action="Index" class="btn btn-link text-muted text-decoration-none mr-3">Trở về danh sách</a>
                            <button type="submit" class="btn btn-save px-5">
                                <i class="fas fa-user-plus mr-2"></i> Khởi tạo tài khoản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/register-user.css">
}

@section Scripts {
    <script>
        $(document).ready(function () {
            var initialLoad = true;
            $('#companySelect').on('change', function() {
                var selectedCompanyId = $(this).val();
                var $deptSelect = $('#deptSelect');
                var currentDeptId = $deptSelect.val();

                if (!selectedCompanyId) {
                    $deptSelect.html('<option value="">-- Chọn phòng ban --</option>');
                    return;
                }

                $.ajax({
                    url: '/department/GetDepartmentsByCompany',
                    type: 'GET',
                    data: { companyId: selectedCompanyId },
                    success: function(response) {
                        if (response.success && response.data) {
                            var options = '<option value="">-- Chọn phòng ban --</option>';
                            response.data.forEach(function(dept) {
                                options += '<option value="' + dept.id + '">' + dept.name + '</option>';
                            });
                            
                            var valToSet = initialLoad ? '@(Model?.DepartmentId ?? "")' : currentDeptId;
                            $deptSelect.html(options);
                            if (valToSet) {
                                $deptSelect.val(valToSet);
                            }
                            initialLoad = false;
                        }
                    },
                    error: function() {
                        alert('Lỗi khi tải danh sách phòng ban!');
                    }
                });
            });

            if($('#companySelect').val()) {
                $('#companySelect').trigger('change');
            }
        });
    </script>
}