<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimal Sidebar Design - @ViewData["Title"]</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap-4.4.1-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free-7.2.0-web/css/all.min.css" />

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync(name: "Styles", required: false)
</head>

<body>
    <div class="d-flex" id="wrapper">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <span class="logo-text">Meeting Pro</span>
                <button class="toggle-btn" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <ul class="menu">

                <li>
                    <a asp-controller="Home" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="fas fa-home menu-icon"></i>
                        <span class="menu-text">Trang chủ</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Company" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" ? "active" : "")">
                        <i class="fas fa-building menu-icon"></i>
                        <span class="menu-text">Quản lý công ty</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Department" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Department" ? "active" : "")">
                        <i class="fas fa-sitemap menu-icon"></i>
                        <span class="menu-text">Phòng ban</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="User" asp-action="Profile"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" && ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                        <i class="fas fa-user-circle menu-icon"></i>
                        <span class="menu-text">Hồ sơ cá nhân</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="User" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" && ViewContext.RouteData.Values["Action"]?.ToString() != "Profile" ? "active" : "")">
                        <i class="fas fa-users-cog menu-icon"></i>
                        <span class="menu-text">Người dùng</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Auth" asp-action="Authorized" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Auth" ? "active" : "")">
                        <i class="fas fa-shield-alt menu-icon"></i>
                        <span class="menu-text">Phân quyền</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Meeting" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Meeting" ? "active" : "")">
                        <i class="fas fa-calendar-alt menu-icon"></i>
                        <span class="menu-text">Lịch họp</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="MeetingRoom" asp-action="Index"
                           class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "MeetingRoom" ? "active" : "")">
                        <i class="fas fa-door-open menu-icon"></i>
                        <span class="menu-text">Phòng họp</span>
                    </a>
                </li>
                <li>
                    <a href="#" class="">
                        <i class="fas fa-cog menu-icon"></i>
                        <span class="menu-text">Cài đặt</span>
                    </a>
                </li>
            </ul>

            <ul class="menu mt-auto">
                <li class="border-top border-secondary pt-2 opacity-50"></li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                        <a href="javascript:void(0)" onclick="document.getElementById('logoutForm').submit()"
                               class="text-danger">
                            <i class="fas fa-sign-out-alt menu-icon"></i>
                            <span class="menu-text">Đăng xuất</span>
                        </a>
                    </form>
                </li>
            </ul>
        </aside>

        <!-- Page Content -->
        <main class="content" id="page-content">
            @RenderBody() <!-- ← This line is REQUIRED to fix your error -->
        </main>
    </div>

    <div id="sidebarBackdrop" class="sidebar-backdrop" style="display:none"></div>

    <!-- Scripts -->
    <script src="~/lib/jquery-4.0.0.min.js"></script>
    <script src="~/lib/bootstrap-4.4.1-dist/js/bootstrap.bundle.min.js"></script>

    <script>
                        $(document).ready(function () {
                            function closeSidebar() {
                                $('body').removeClass('sidebar-expanded');
                                $('#sidebarBackdrop').hide();
                            }

                            function openSidebar() {
                                $('body').addClass('sidebar-expanded');
                                $('#sidebarBackdrop').show();
                            }

                            $('#sidebarToggle').on('click', function () {
                                if ($('body').hasClass('sidebar-expanded')) {
                                    closeSidebar();
                                } else {
                                    openSidebar();
                                }
                            });

                            $('#sidebarBackdrop').on('click', function () {
                                closeSidebar();
                            });
                        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("AfterBodyScripts", required: false)
</body>

</html>