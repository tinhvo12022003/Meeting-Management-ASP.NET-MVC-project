@{
    var sidebarState = Context.Request.Cookies["sidebar_state"] ?? "expanded";
    var isExpanded = sidebarState == "expanded";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meeting Pro - @ViewData["Title"]</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap-4.4.1-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free-7.2.0-web/css/all.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync(name: "Styles", required: false)
</head>

<body class="@(isExpanded ? "sidebar-expanded" : "")">

    <!-- ========== MOBILE TOP HEADER (visible only on ≤768px) ========== -->
    <header class="mobile-header" id="mobileHeader">
        <span class="mobile-logo">Meeting Pro</span>
        <button class="mobile-toggle-btn" id="mobileSidebarToggle" aria-label="Mở menu">
            <i class="fas fa-bars"></i>
        </button>
    </header>

    <div class="d-flex" id="wrapper">

        <!-- ========== SIDEBAR ========== -->
        <aside class="sidebar" id="sidebar" role="navigation" aria-label="Main navigation">

            <!-- Sidebar Header (Desktop) -->
            <div class="sidebar-header">
                <span class="logo-text">Danh mục</span>
                <button class="toggle-btn" id="sidebarToggle" aria-label="Thu gọn menu">
                    <i class="fas fa-bars"></i>
                </button>
            </div>

            <!-- Main Navigation -->
            <ul class="menu">

                <li>
                    <a asp-controller="Meeting" asp-action="Index"
                       title="Lịch họp"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Meeting" ? "active" : "")">
                        <i class="fas fa-calendar-alt menu-icon"></i>
                        <span class="menu-text">Lịch họp</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Company" asp-action="Index"
                       title="Quản lý công ty"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Company" ? "active" : "")">
                        <i class="fas fa-building menu-icon"></i>
                        <span class="menu-text">Quản lý công ty</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Department" asp-action="Index"
                       title="Phòng ban"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Department" ? "active" : "")">
                        <i class="fas fa-sitemap menu-icon"></i>
                        <span class="menu-text">Phòng ban</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="MeetingRoom" asp-action="Index"
                       title="Phòng họp"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "MeetingRoom" ? "active" : "")">
                        <i class="fas fa-door-open menu-icon"></i>
                        <span class="menu-text">Phòng họp</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="User" asp-action="Profile"
                       title="Hồ sơ cá nhân"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" && ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")">
                        <i class="fas fa-user-circle menu-icon"></i>
                        <span class="menu-text">Hồ sơ cá nhân</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="User" asp-action="Index"
                       title="Người dùng"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "User" && ViewContext.RouteData.Values["Action"]?.ToString() != "Profile" ? "active" : "")">
                        <i class="fas fa-users-cog menu-icon"></i>
                        <span class="menu-text">Người dùng</span>
                    </a>
                </li>

                <li>
                    <a asp-controller="Auth" asp-action="Authorized"
                       title="Phân quyền"
                       class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Auth" ? "active" : "")">
                        <i class="fas fa-shield-alt menu-icon"></i>
                        <span class="menu-text">Phân quyền</span>
                    </a>
                </li>

            </ul>

            <!-- Bottom: Logout -->
            <ul class="menu mt-auto">
                <li class="border-top border-secondary pt-2 opacity-50"></li>
                <li>
                    <form asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm">
                        <a href="javascript:void(0)"
                           onclick="document.getElementById('logoutForm').submit()"
                           title="Đăng xuất"
                           class="text-danger">
                            <i class="fas fa-sign-out-alt menu-icon"></i>
                            <span class="menu-text">Đăng xuất</span>
                        </a>
                    </form>
                </li>
            </ul>

        </aside>

        <!-- ========== PAGE CONTENT ========== -->
        <main class="content" id="page-content">
            @RenderBody()
        </main>

    </div>

    <!-- Backdrop (Mobile overlay) -->
    <div id="sidebarBackdrop" class="sidebar-backdrop"></div>

    <!-- ========== SCRIPTS ========== -->
    <script src="~/lib/jquery-4.0.0.min.js"></script>
    <script src="~/lib/bootstrap-4.4.1-dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            'use strict';

            // Breakpoints
            var MOBILE_BP = 768;
            var TABLET_BP = 1024;

            function isMobile() { return window.innerWidth <= MOBILE_BP; }
            function isTablet() { return window.innerWidth > MOBILE_BP && window.innerWidth <= TABLET_BP; }

            // ---- State Management ----
            function setCookie(name, value, days) {
                var expires = "";
                if (days) {
                    var date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    expires = "; expires=" + date.toUTCString();
                }
                document.cookie = name + "=" + (value || "") + expires + "; path=/";
            }

            function setSidebarExpanded(expanded) {
                if (expanded) {
                    document.body.classList.add('sidebar-expanded');
                    localStorage.setItem('sidebar-state', 'expanded');
                    setCookie('sidebar_state', 'expanded', 30);
                } else {
                    document.body.classList.remove('sidebar-expanded');
                    localStorage.setItem('sidebar-state', 'collapsed');
                    setCookie('sidebar_state', 'collapsed', 30);
                }
            }

            function isSidebarExpanded() {
                return document.body.classList.contains('sidebar-expanded');
            }

            // ---- Mobile icon toggle ----
            function updateMobileToggleIcon() {
                var mobileBtn = document.getElementById('mobileSidebarToggle');
                if (!mobileBtn) return;
                var icon = mobileBtn.querySelector('i');
                if (icon) {
                    if (isSidebarExpanded()) {
                        icon.className = 'fas fa-times';
                    } else {
                        icon.className = 'fas fa-bars';
                    }
                }
            }

            // ---- Initialize sidebar state ----
            function initSidebar() {
                var state = document.cookie.match(/sidebar_state=([^;]+)/);
                var saved = state ? state[1] : localStorage.getItem('sidebar-state');

                if (isMobile()) {
                    setSidebarExpanded(false);
                } else if (isTablet()) {
                    setSidebarExpanded(saved === 'expanded');
                } else {
                    // Desktop: expanded is default
                    setSidebarExpanded(saved !== 'collapsed');
                }

                updateMobileToggleIcon();
            }

            // ---- Toggle handlers ----
            function toggleSidebar() {
                setSidebarExpanded(!isSidebarExpanded());
                updateMobileToggleIcon();
            }

            // Desktop toggle button
            var desktopToggle = document.getElementById('sidebarToggle');
            if (desktopToggle) {
                desktopToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    toggleSidebar();
                });
            }

            // Mobile toggle button
            var mobileToggle = document.getElementById('mobileSidebarToggle');
            if (mobileToggle) {
                mobileToggle.addEventListener('click', function (e) {
                    e.preventDefault();
                    toggleSidebar();
                });
            }

            // Backdrop click → close sidebar on mobile
            var backdrop = document.getElementById('sidebarBackdrop');
            if (backdrop) {
                backdrop.addEventListener('click', function () {
                    if (isMobile()) {
                        setSidebarExpanded(false);
                        updateMobileToggleIcon();
                    }
                });
            }

            // Close sidebar when clicking a menu item on mobile (auto-close)
            var menuLinks = document.querySelectorAll('.menu a');
            menuLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    if (isMobile() && isSidebarExpanded()) {
                        setSidebarExpanded(false);
                        updateMobileToggleIcon();
                    }
                });
            });

            // ---- Handle window resize ----
            var resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function () {
                    // When resize crosses mobile boundary, reset appropriately
                    if (isMobile()) {
                        setSidebarExpanded(false);
                    } else if (!isTablet()) {
                        // Back to desktop - expand by default if no preference
                        var saved = localStorage.getItem('sidebar-state');
                        if (!saved || saved === 'expanded') {
                            setSidebarExpanded(true);
                        }
                    }
                    updateMobileToggleIcon();
                }, 150);
            });

            // Run init
            initSidebar();

            // ---- Global AJAX Antiforgery ----
            if (typeof $ !== 'undefined') {
                $(document).ready(function () {
                    $.ajaxSetup({
                        beforeSend: function (xhr) {
                            xhr.setRequestHeader('X-XSRF-TOKEN',
                                $('input:hidden[name="__RequestVerificationToken"]').val());
                        }
                    });
                });
            }

        })();
    </script>

    @Html.AntiForgeryToken()
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("AfterBodyScripts", required: false)

    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <script>
            $(document).ready(function () {
                @if (TempData["Success"] != null)
                {
                    <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Thành công',
                            text: '@Html.Raw(TempData["Success"])',
                            showConfirmButton: false,
                            timer: 3000,
                            timerProgressBar: true,
                            toast: true,
                            position: 'top-end'
                        });
                    </text>
                }
                @if (TempData["Error"] != null)
                {
                    <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi',
                            text: '@Html.Raw(TempData["Error"])',
                            confirmButtonColor: '#4f46e5'
                        });
                    </text>
                }
            });
        </script>
    }

</body>
</html>