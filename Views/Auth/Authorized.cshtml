@using MeetingManagement.Models.DTOs
<!-- 

-->

@{
    ViewData["Title"] = "Phân quyền người dùng";
    var users = ViewBag.Users as List<UserViewModel> ?? new List<UserViewModel>();
    var selectedUserId = ViewBag.SelectedUserId as string;
    var permissionConfig = ViewBag.PermissionConfig as List<dynamic> ?? new List<dynamic>();
    var userPermissions = ViewBag.UserPermissions as List<PermissionViewModel> ?? new List<PermissionViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/authorized.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
    <style>
        .select2-container--default .select2-selection--single {
            height: 50px !important;
            border-radius: 12px !important;
            border: none !important;
            padding-top: 10px !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .select2-container--default .select2-selection--single .select2-selection__arrow {
            top: 12px !important;
        }
        .select2-dropdown {
            border-radius: 12px !important;
            border: none !important;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .select2-search__field {
            border-radius: 8px !important;
            padding: 8px 12px !important;
        }
    </style>
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-11">
            
            <!-- User Selection -->
            <div class="user-selector-card">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        <h2 class="font-weight-bold mb-3"><i class="fas fa-user-shield mr-2"></i>Phân quyền Hệ thống</h2>
                        <p class="mb-0 text-white-50">Tìm kiếm nhân viên bằng tên hoặc tài khoản để thực hiện thiết lập quyền hạn.</p>
                    </div>
                    <div class="col-md-5 mt-3 mt-md-0">
                        <div class="form-group mb-0">
                            <label class="small text-white-50 font-weight-bold mb-2">TÌM KIẾM NGƯỜI DÙNG</label>
                            <select id="userSelect" class="form-control select2" style="width: 100%;">
                                <option value="">-- Nhập tên hoặc username --</option>
                                @foreach (var u in users)
                                {
                                    <option value="@u.Id" selected="@(selectedUserId == u.Id)">[@u.Username] @u.FullName</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            @if (string.IsNullOrEmpty(selectedUserId))
            {
                <div class="search-hero-section text-center py-5">
                    <div class="search-illustration mb-4">
                        <div class="circle-bg">
                            <i class="fas fa-search-plus fa-4x text-primary op-20"></i>
                        </div>
                    </div>
                    <h3 class="font-weight-bold text-dark">Bắt đầu Phân quyền</h3>
                    <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                        Sử dụng thanh tìm kiếm phía trên để tìm nhân viên theo tên, email hoặc tài khoản đăng nhập để bắt đầu thiết lập quyền hạn truy cập hệ thống.
                    </p>
                    <div class="d-flex justify-content-center">
                        <div class="badge-info-item mx-2">
                            <i class="fas fa-check-circle mr-1"></i> Tìm nhanh bằng Username
                        </div>
                        <div class="badge-info-item mx-2">
                            <i class="fas fa-check-circle mr-1"></i> Tìm bằng Tên đầy đủ
                        </div>
                    </div>
                </div>

                <style>
                    .search-hero-section {
                        background: white;
                        border-radius: 20px;
                        border: 1px dashed #cbd5e1;
                        margin-top: 2rem;
                    }
                    .circle-bg {
                        width: 120px;
                        height: 120px;
                        background: var(--bg-light);
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        margin: 0 auto;
                    }
                    .op-20 { opacity: 0.2; }
                    .badge-info-item {
                        padding: 0.5rem 1rem;
                        background: var(--bg-light);
                        border-radius: 30px;
                        font-size: 0.85rem;
                        color: #64748b;
                        font-weight: 500;
                    }
                </style>
            }
            else
            {
                <div id="permissionGrid" class="mt-4">
                    @foreach (var config in permissionConfig)
                    {
                        var controllerPermissions = userPermissions.Where(p => p.Controller == config.Controller).ToList();
                        var hasFullAtController = controllerPermissions.Any(p => p.FullPermission && p.Action == "*");

                        <div class="permission-card" data-controller="@config.Controller">
                            <div class="card-header-permission">
                                <div class="d-flex align-items-center">
                                    <div class="rounded-circle bg-primary-light p-2 mr-3" style="width:40px; height:40px; display:flex; align-items:center; justify-content:center; color: var(--primary)">
                                        <i class="fas fa-boxes"></i>
                                    </div>
                                    <div>
                                        <div class="controller-title">@config.DisplayName</div>
                                        <span class="small text-muted">Controller: @config.Controller</span>
                                    </div>
                                </div>
                                <div class="custom-control custom-switch">
                                    <input type="checkbox" class="custom-control-input controller-full" id="full_@config.Controller" 
                                           data-controller="@config.Controller" @(hasFullAtController ? "checked" : "")>
                                    <label class="custom-control-label font-weight-bold" for="full_@config.Controller">Full Access</label>
                                </div>
                            </div>
                            
                            <div class="table-responsive">
                                <table class="table table-permission table-hover">
                                    <thead>
                                        <tr>
                                            <th style="min-width: 200px;">Hành động (Action)</th>
                                            <th class="text-center">View</th>
                                            <th class="text-center">Insert</th>
                                            <th class="text-center">Edit</th>
                                            <th class="text-center">Delete</th>
                                            <th class="text-center">Ins All</th>
                                            <th class="text-center">Ed All</th>
                                            <th class="text-center">Del All</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (string action in config.Actions)
                                        {
                                            var p = controllerPermissions.FirstOrDefault(cp => cp.Action == action);
                                            <tr class="action-row" data-action="@action">
                                                <td><span class="action-name">@action</span></td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="v_@config.Controller@action" data-type="View" @(p?.View == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="v_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="i_@config.Controller@action" data-type="Insert" @(p?.Insert == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="i_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="e_@config.Controller@action" data-type="Edit" @(p?.Edit == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="e_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="d_@config.Controller@action" data-type="Delete" @(p?.Delete == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="d_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="ia_@config.Controller@action" data-type="InsertAll" @(p?.InsertAll == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="ia_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="ea_@config.Controller@action" data-type="EditAll" @(p?.EditAll == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="ea_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                                <td class="text-center">
                                                    <div class="custom-control custom-checkbox custom-control-inline mx-0">
                                                        <input type="checkbox" class="custom-control-input perm-check" id="da_@config.Controller@action" data-type="DeleteAll" @(p?.DeleteAll == true ? "checked" : "")>
                                                        <label class="custom-control-label" for="da_@config.Controller@action"></label>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    <div class="sticky-save mb-5">
                        <button type="button" id="btnSavePermissions" class="btn-update shadow-lg">
                            <i class="fas fa-save mr-2"></i> CẬP NHẬT QUYỀN HẠN
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Initialize Select2
            $('.select2').select2({
                placeholder: "-- Nhập tên hoặc username --",
                allowClear: true,
                language: {
                    noResults: function () {
                        return "Không tìm thấy người dùng nào";
                    }
                }
            });

            // Focus search field when select2 is opened
            $(document).on('select2:open', () => {
                document.querySelector('.select2-search__field').focus();
            });

            // Handle user change
            $('#userSelect').on('change', function () {
                const userId = $(this).val();
                if (userId) {
                    window.location.href = '@Url.Action("Authorized", "Auth")?userId=' + userId;
                } else {
                    window.location.href = '@Url.Action("Authorized", "Auth")';
                }
            });

            // Handle Full Permission (Controller level)
            $('.controller-full').on('change', function () {
                const controllerCard = $(this).closest('.permission-card');
                const isChecked = $(this).prop('checked');
                
                // Toggle all checkboxes in this controller card
                controllerCard.find('.perm-check').prop('checked', isChecked);
                
                if (isChecked) {
                    controllerCard.find('.table-responsive').addClass('opacity-50');
                    controllerCard.find('.perm-check').prop('disabled', true);
                } else {
                    controllerCard.find('.table-responsive').removeClass('opacity-50');
                    controllerCard.find('.perm-check').prop('disabled', false);
                }
            });

            // Initial check for visually disabling already "Full Access" controllers
            $('.controller-full:checked').each(function() {
                const controllerCard = $(this).closest('.permission-card');
                controllerCard.find('.table-responsive').addClass('opacity-50');
                controllerCard.find('.perm-check').prop('disabled', true);
            });

            // Save Permissions
            $('#btnSavePermissions').on('click', function () {
                const userId = $('#userSelect').val();
                if (!userId) {
                    Swal.fire('Lỗi', 'Vui lòng chọn người dùng!', 'error');
                    return;
                }

                const payload = {
                    userId: userId,
                    permissions: []
                };

                $('.permission-card').each(function () {
                    const controller = $(this).data('controller');
                    const isFull = $(this).find('.controller-full').prop('checked');

                    if (isFull) {
                        // All permissions for this controller
                        payload.permissions.push({
                            controller: controller,
                            action: "*",
                            fullPermission: true,
                            view: true, insert: true, edit: true, delete: true,
                            insertAll: true, editAll: true, deleteAll: true
                        });
                    } else {
                        // Collect per-action permissions
                        $(this).find('.action-row').each(function () {
                            const action = $(this).data('action');
                            const row = $(this);
                            
                            const p = {
                                controller: controller,
                                action: action,
                                fullPermission: false,
                                view: row.find('[data-type="View"]').prop('checked'),
                                insert: row.find('[data-type="Insert"]').prop('checked'),
                                edit: row.find('[data-type="Edit"]').prop('checked'),
                                delete: row.find('[data-type="Delete"]').prop('checked'),
                                insertAll: row.find('[data-type="InsertAll"]').prop('checked'),
                                editAll: row.find('[data-type="EditAll"]').prop('checked'),
                                deleteAll: row.find('[data-type="DeleteAll"]').prop('checked')
                            };

                            // Only add if at least one permission is checked
                            if (p.view || p.insert || p.edit || p.delete || p.insertAll || p.editAll || p.deleteAll) {
                                payload.permissions.push(p);
                            }
                        });
                    }
                });

                // Send to API
                Swal.fire({
                    title: 'Đang xử lý...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                $.ajax({
                    url: '/auth/save-permissions',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Thành công', res.message, 'success').then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi', res.message, 'error');
                        }
                    },
                    error: function (err) {
                        Swal.fire('Lỗi', 'Có lỗi xảy ra khi kết nối server.', 'error');
                    }
                });
            });
        });
    </script>
}
