@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model CompanyUpdateModel

@{
    ViewData["Title"] = "Chỉnh sửa Công ty";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 p-0 bg-transparent">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted small">Quản lý Công ty</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Chỉnh sửa</li>
                </ol>
            </nav>

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle mr-3 shadow-sm back-btn">
                    <i class="fas fa-arrow-left text-muted"></i>
                </a>
                <div>
                    <h3 class="font-weight-bold mb-0">Chỉnh sửa công ty</h3>
                    @* <p class="text-muted small mb-0 mt-1">
                        <i class="fas fa-fingerprint mr-1"></i>ID: <code class="company-id-badge">@Model.Id</code>
                    </p> *@
                </div>
            </div>

            <div class="card border-0 shadow-sm update-card">
                <!-- Card accent top bar -->
                <div class="card-accent-bar"></div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Update" method="post" id="updateCompanyForm">
                        @Html.AntiForgeryToken()
                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4 validation-alert"></div>

                        <!-- Section: Thông tin cơ bản -->
                        <div class="section-label mb-3">
                            <i class="fas fa-info-circle mr-2 text-primary"></i>
                            <span>Thông tin cơ bản</span>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Name" class="form-label font-weight-bold text-dark small text-uppercase mb-2">
                                    Tên công ty <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0">
                                            <i class="fas fa-building text-muted"></i>
                                        </span>
                                    </div>
                                    <input asp-for="Name" class="form-control bg-light border-left-0 custom-input"
                                           placeholder="Ví dụ: Công ty Công nghệ ABC..." required />
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label font-weight-bold text-dark small text-uppercase mb-2">
                                    Email liên hệ <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0">
                                            <i class="fas fa-envelope text-muted"></i>
                                        </span>
                                    </div>
                                    <input asp-for="Email" type="email" class="form-control bg-light border-left-0 custom-input"
                                           placeholder="contact@company.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label font-weight-bold text-dark small text-uppercase mb-2">
                                    Số điện thoại
                                </label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0">
                                            <i class="fas fa-phone text-muted"></i>
                                        </span>
                                    </div>
                                    <input asp-for="Phone" class="form-control bg-light border-left-0 custom-input"
                                           placeholder="028 1234 5678" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label asp-for="Address" class="form-label font-weight-bold text-dark small text-uppercase mb-2">
                                    Địa chỉ trụ sở <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0">
                                            <i class="fas fa-map-marker-alt text-muted"></i>
                                        </span>
                                    </div>
                                    <input asp-for="Address" class="form-control bg-light border-left-0 custom-input"
                                           placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <hr class="my-2 border-light">

                        <!-- Section: Thông tin bổ sung -->
                        <div class="section-label my-3">
                            <i class="fas fa-file-alt mr-2 text-primary"></i>
                            <span>Thông tin bổ sung</span>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="TaxCode" class="form-label font-weight-bold text-dark small text-uppercase mb-2">
                                    Mã số thuế
                                </label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0">
                                            <i class="fas fa-receipt text-muted"></i>
                                        </span>
                                    </div>
                                    <input asp-for="TaxCode" class="form-control bg-light border-left-0 custom-input"
                                           placeholder="VD: 0123456789" />
                                </div>
                                <span asp-validation-for="TaxCode" class="text-danger small mt-1"></span>
                            </div>

                            @* <div class="col-md-6 mb-4">
                                <label asp-for="RowStatus" class="form-label font-weight-bold text-dark small text-uppercase mb-2">
                                    Trạng thái <span class="text-danger">*</span>
                                </label>
                                <div class="status-select-wrapper">
                                    <select asp-for="RowStatus" class="form-control custom-select custom-input" id="statusSelect">
                                        @foreach (RowStatus status in System.Enum.GetValues(typeof(RowStatus)))
                                        {
                                            <option value="@status">
                                                @(status == RowStatus.ACTIVE ? "Đang hoạt động" : "Ngừng hoạt động")
                                            </option>
                                        }
                                    </select>
                                    <div class="status-indicator" id="statusIndicator"></div>
                                </div>
                                <span asp-validation-for="RowStatus" class="text-danger small mt-1"></span>
                            </div> *@
                        </div>

                        <hr class="my-4 border-light">

                        <div class="form-actions d-flex flex-column flex-md-row justify-content-end gap-3 pt-4 m-2">

                            <a asp-action="Index" class="btn btn-light btn-cancel px-4">
                                Hủy bỏ
                            </a>

                            <button type="submit" class="btn btn-primary btn-save px-4">
                                <i class="fas fa-save me-2"></i>
                                Lưu cập nhật
                            </button>

                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/update-companies.css">
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Track unsaved changes
            let isDirty = false;
            const originalData = $('#updateCompanyForm').serialize();

            $('#updateCompanyForm input, #updateCompanyForm select, #updateCompanyForm textarea').on('input change', function () {
                const currentData = $('#updateCompanyForm').serialize();
                isDirty = currentData !== originalData;
                $('.unsaved-badge').toggle(isDirty);
            });

            // Confirm leave if unsaved
            window.addEventListener('beforeunload', function (e) {
                if (isDirty) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });

            // On submit: remove dirty flag so no prompt
            $('#updateCompanyForm').on('submit', function () {
                isDirty = false;
                const btn = $('#submitBtn');
                btn.addClass('loading').html('<i class="fas fa-spinner fa-spin mr-2"></i> Đang lưu...');
            });
        });
    </script>
}
