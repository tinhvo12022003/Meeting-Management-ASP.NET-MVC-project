@using MeetingManagement.Common
@using MeetingManagement.Enum
@using MeetingManagement.Models.DTOs
@model PaginatedResponse<CompanyViewModel>

@{
    ViewData["Title"] = "Quản lý Công ty";
}

@section Styles {
    <style>
        .table-container {
            background: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            padding: 1.5rem;
            border: 1px solid var(--border-color);
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            gap: 1.5rem;
            flex-wrap: wrap;
        }

        .search-box {
            position: relative;
            flex-grow: 1;
            max-width: 450px;
        }

        .search-box i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        .search-box input {
            width: 100%;
            padding: 0.75rem 1rem 0.75rem 2.75rem;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            outline: none;
            transition: var(--transition);
            font-size: 0.875rem;
            background: #fdfdfd;
        }

        .search-box input:focus {
            border-color: var(--primary-color);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

        .custom-table th {
            background: #f8fafc;
            padding: 1rem;
            font-weight: 600;
            text-align: left;
            color: var(--text-muted);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--border-color);
        }

        .custom-table td {
            padding: 1.25rem 1rem;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-main);
            font-size: 0.875rem;
            transition: var(--transition);
        }

        .custom-table tbody tr:last-child td {
            border-bottom: none;
        }

        .custom-table tbody tr:hover td {
            background-color: #f8fafc;
        }

        /* Company Cell */
        .company-cell {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .company-logo {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: var(--primary-color);
            font-size: 1.125rem;
            flex-shrink: 0;
        }

        .company-info .name {
            display: block;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 2px;
        }

        /* Actions */
        .action-btns {
            display: flex;
            gap: 0.75rem;
        }

        .btn-icon-link {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background: #fff;
            color: var(--text-muted);
            transition: var(--transition);
            text-decoration: none !important;
        }

        .btn-icon-link:hover {
            transform: translateY(-2px);
        }

        .btn-edit:hover {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: #f5f3ff;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.15);
        }

        .btn-delete:hover {
            color: var(--danger);
            border-color: var(--danger);
            background: #fef2f2;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.15);
        }

        /* Pagination */
        .table-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 2rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--border-color);
        }

        .pagination-info {
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .pagination-btns {
            display: flex;
            gap: 0.5rem;
        }

        .btn-page {
            min-width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.5rem;
            border: 1px solid var(--border-color);
            background: #fff;
            border-radius: 8px;
            font-size: 0.875rem;
            color: var(--text-main);
            text-decoration: none !important;
            transition: var(--transition);
        }

        .btn-page.active {
            background: var(--primary-color);
            color: #fff;
            border-color: var(--primary-color);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
        }

        .btn-page:hover:not(.active) {
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: #f5f3ff;
        }

        .btn-add-new {
            background: var(--primary-color);
            color: #fff;
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            transition: var(--transition);
            border: none;
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
            text-decoration: none !important;
        }

        .btn-add-new:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(79, 70, 229, 0.3);
            color: #fff;
        }

        .breadcrumb-container {
            margin-bottom: 2rem;
        }

        .breadcrumb-label {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.025em;
            margin: 0;
        }

        .badge-status {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.375rem 0.875rem;
            border-radius: 99px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .status-active {
            background: #ecfdf5;
            color: #065f46;
        }
        .status-active .status-dot { background: var(--success); }

        .status-inactive {
            background: #fef2f2;
            color: #991b1b;
        }
        .status-inactive .status-dot { background: var(--danger); }
    </style>
}

<div class="container-fluid">
    <div class="breadcrumb-container d-flex justify-content-between align-items-end">
        <div>
            <p class="text-uppercase text-muted small font-weight-bold mb-1 tracking-wider">Hệ thống quản trị</p>
            <h1 class="breadcrumb-label">Quản lý Công ty</h1>
        </div>
        <a asp-controller="Company" asp-action="Create" class="btn-add-new">
            <i class="fas fa-plus"></i>
            Thêm công ty mới
        </a>
    </div>

    <div class="table-container">
        <form method="get" action="/Company" id="filterForm" class="table-header">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" name="searchTerm" id="searchTerm"
                       value="@Context.Request.Query["searchTerm"]"
                       placeholder="Tìm kiếm theo tên hoặc địa chỉ công ty...">
            </div>
            @* <div class="d-flex gap-3 align-items-center">
                @{
                    var currentStatus = Context.Request.Query["status"].ToString();
                }
                <select name="status" id="statusFilter" class="form-control custom-select"
                        style="min-width: 180px; height: 44px; border-radius: 10px;">
                    <option value="" selected="@(string.IsNullOrEmpty(currentStatus))">Tất cả trạng thái</option>
                    <option value="ACTIVE" selected="@(currentStatus == "ACTIVE")">Đang hoạt động</option>
                    <option value="INACTIVE" selected="@(currentStatus == "INACTIVE")">Ngừng hoạt động</option>
                </select>
                <button type="submit" class="btn btn-outline-light text-dark font-weight-bold d-inline-flex align-items-center"
                        style="height:44px;border-radius:10px;border:1px solid var(--border-color);padding:0 12px;gap:0.5rem;">
                    <i class="fas fa-filter text-muted" style="line-height:1;"></i>
                    <span style="line-height:1;">Lọc</span>
                </button>
                @if (!string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(Context.Request.Query["searchTerm"].ToString()))
                {
                    <a href="/Company" class="btn btn-outline-light text-danger font-weight-bold d-inline-flex align-items-center"
                       style="height:44px;border-radius:10px;border:1px solid #fca5a5;padding:0 12px;gap:0.5rem;text-decoration:none;">
                        <i class="fas fa-times" style="line-height:1;"></i>
                        <span style="line-height:1;">Xóa lọc</span>
                    </a>
                }
            </div> *@
        </form>


        <div class="table-responsive">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th style="width: 15%">Tên Công Ty</th>
                        <th style="width: 20%">Địa Chỉ</th>
                        <th style="width: 15%">Điện thoại</th>
                        <th style="width: 15%">Email</th>
                        <th style="width: 20%">Mã số thuế</th>
                        <th style="width: 10%" class="text-right">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="company-cell">
                                        <div class="company-logo">
                                            @(item.Name?.Substring(0, 1).ToUpper() ?? "C")
                                        </div>
                                        <div class="company-info">
                                            <span class="name">@item.Name</span>
                                            <span class="email text-muted small">@item.Id</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="fas fa-map-marker-alt mr-2 small"></i>
                                        @item.Address
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="fas fa-phone mr-2 small"></i>
                                        @item.Phone
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="fas fa-envelope mr-2 small"></i>
                                        @item.Email
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="fas fa-file-invoice mr-2 small"></i>
                                        @item.TaxCode
                                    </div>
                                </td>


                                @* <td>
                                    @if (item.rowStatus == RowStatus.ACTIVE)
                                    {
                                        <div class="badge-status status-active">
                                            <div class="status-dot"></div>
                                            Hoạt động
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="badge-status status-inactive">
                                            <div class="status-dot"></div>
                                            Ngừng hoạt động
                                        </div>
                                    }
                                </td> *@
                                <td>
                                    <div class="action-btns justify-content-end">
                                        <a href="/Company/Update/@item.Id" class="btn-icon-link btn-edit" title="Chỉnh sửa">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-controller="Company" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn-icon-link btn-delete" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa công ty \"@item.Name\"?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="fas fa-folder-open fa-3x mb-3 opacity-20"></i>
                                    <p>Không tìm thấy dữ liệu nào phù hợp</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            @{
                var pSearch = Context.Request.Query["searchTerm"].ToString();
                var pStatus = Context.Request.Query["status"].ToString();
                string PageUrl(int page) => $"?pageNumber={page}&searchTerm={pSearch}&status={pStatus}";
            }
            <div class="pagination-info">
                Hiển thị bản ghi từ <strong>@((Model.PageNumber - 1) * Model.PageSize + 1)</strong> đến 
                <strong>@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalRecords))</strong> trong tổng số 
                <strong>@Model.TotalRecords</strong>
            </div>
            <div class="pagination-btns">
                @if (Model.HasPreviousPage)
                {
                    <a href="@PageUrl(Model.PageNumber - 1)" class="btn-page">
                        <i class="fas fa-chevron-left"></i>
                    </a>
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 1 && i <= Model.PageNumber + 1))
                    {
                        <a href="@PageUrl(i)" class="btn-page @(i == Model.PageNumber ? "active" : "")">@i</a>
                    }
                    else if (i == Model.PageNumber - 2 || i == Model.PageNumber + 2)
                    {
                        <span class="px-2">...</span>
                    }
                }

                @if (Model.HasNextPage)
                {
                    <a href="@PageUrl(Model.PageNumber + 1)" class="btn-page">
                        <i class="fas fa-chevron-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteCompany(id, name) {
            if (confirm('Bạn có chắc chắn muốn xóa công ty "' + name + '"?')) {
                // Triển khai logic xóa ở đây (ví dụ: gọi API)
                alert('Đang thực hiện xóa công ty có ID: ' + id);
            }
        }
    </script>
}