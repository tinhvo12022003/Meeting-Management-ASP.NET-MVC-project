@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model CompanyCreateModel

@{
    ViewData["Title"] = "Thêm Công ty";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Breadcrumb -->
            @* <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 p-0 bg-transparent">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted small">Quản lý Công ty</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Thêm mới</li>
                </ol>
            </nav> *@

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle mr-3 shadow-sm" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-arrow-left text-muted"></i>
                </a>
                <h3 class="font-weight-bold mb-0">Tạo công ty mới</h3>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" method="post" id="createCompanyForm">
                        @Html.AntiForgeryToken()
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" style="border-radius: 8px;"></div>
                        }

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Name" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Tên công ty <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-building text-muted"></i></span>
                                    </div>
                                    <input asp-for="Name" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Ví dụ: Công ty Công nghệ ABC..." required>
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Email liên hệ <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-envelope text-muted"></i></span>
                                    </div>
                                    <input asp-for="Email" type="email" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="contact@company.com" required>
                                </div>
                                <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Số điện thoại <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-phone text-muted"></i></span>
                                    </div>
                                    <input asp-for="Phone" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="028 1234 5678" required>
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label asp-for="Address" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Địa chỉ trụ sở <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                                    </div>
                                    <input asp-for="Address" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." required>
                                </div>
                                <span asp-validation-for="Address" class="text-danger small mt-1"></span>
                            </div>


                            <div class="col-md-12 mb-4">
                                <label asp-for="TaxCode" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Mã số thuế <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-receipt text-muted"></i></span>
                                    </div>
                                    <input asp-for="TaxCode" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" required>
                                </div>
                                <span asp-validation-for="TaxCode" class="text-danger small mt-1"></span>
                            </div>


                        </div>

                        <hr class="my-4 border-light">

                        <div class="form-actions d-flex flex-column flex-md-row justify-content-end gap-3 pt-4 m-2">

                            <a asp-action="Index" class="btn btn-light btn-cancel px-4">
                                Hủy bỏ
                            </a>

                            <button type="submit" class="btn btn-primary btn-save px-4">
                                <i class="fas fa-save me-2"></i>
                                Lưu công ty
                            </button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/create-companies.css">
}