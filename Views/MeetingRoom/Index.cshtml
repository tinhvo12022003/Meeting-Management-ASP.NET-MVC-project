@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model MeetingManagement.Common.PaginatedResponse<MeetingRoomViewModel>

@{
    ViewData["Title"] = "Quản lý Phòng họp";
}

<div class="container-fluid px-4 py-4">
    <div class="page-header">
        <div class="header-title">
            <h3>Hệ thống Phòng họp</h3>
            @* <p class="text-muted small">Quản lý không gian họp nội bộ tối giản & hiệu quả</p> *@
        </div>
        <div class="header-actions">
            <a asp-action="Create" class="btn-header btn-header-primary">
                <i class="fas fa-plus"></i> Thêm phòng
            </a>
        </div>
    </div>

    <!-- Minimal Stats -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stat-card glass-card p-3 d-flex align-items-center">
                <div class="stat-icon bg-soft-primary mr-3">
                    <i class="fas fa-building text-primary"></i>
                </div>
                <div>
                    <span class="text-muted small font-weight-bold d-block text-uppercase">Tổng số phòng</span>
                    <h4 class="font-weight-bold mb-0">@Model.TotalRecords</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card glass-card p-3 d-flex align-items-center">
                <div class="stat-icon bg-soft-success mr-3">
                    <i class="fas fa-check-circle text-success"></i>
                </div>
                <div>
                    <span class="text-muted small font-weight-bold d-block text-uppercase">Đang hoạt động</span>
                    <h4 class="font-weight-bold mb-0">@Model.Items.Count()</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card border-0 shadow-sm glass-card" style="border-radius: 20px;">
        <div class="card-header bg-transparent border-0 pt-4 px-4">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="font-weight-bold mb-0">Danh sách phòng họp</h5>
                </div>
                <div class="col-md-4">
                    <form asp-action="Index" method="get">
                        <div class="input-group bg-light border-0 shadow-none"
                             style="border-radius: 12px; overflow: hidden;">
                            <div class="input-group-prepend px-3 d-flex align-items-center">
                                <i class="fas fa-search text-muted small"></i>
                            </div>
                            <input type="text" name="SearchTerm" class="form-control bg-light border-0 pl-0 small"
                                   placeholder="Tìm tên phòng..." value="@Context.Request.Query["SearchTerm"]">
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="card-body px-0 pb-0">
            <div class="table-responsive">
                <table class="table table-hover align-items-center mb-0">
                    <thead class="bg-light-faded">
                        <tr>
                            <th class="px-4 text-muted small text-uppercase font-weight-bold">Tên phòng</th>
                            <th class="text-center text-muted small text-uppercase font-weight-bold">Sức chứa</th>
                            <th class="text-center text-muted small text-uppercase font-weight-bold">Vị trí</th>
                            <th class="text-muted small text-uppercase font-weight-bold">Công ty</th>
                            <th class="px-4 text-right text-muted small text-uppercase font-weight-bold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted small italic">Chưa có dữ liệu phòng họp.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="px-4">
                                    <span class="font-weight-600 text-dark">@item.Name</span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-soft-indigo px-3 py-2" style="border-radius: 8px;">
                                        <i class="fas fa-users mr-1"></i> @item.Capacity
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-soft-indigo px-3 py-2" style="border-radius: 8px;">
                                        <i class="fas fa-map-marker-alt text-muted"></i> @item.Location
                                    </span>
                                </td>

                                <td>
                                    <span class="text-muted small font-weight-500">@item.CompanyName</span>
                                </td>
                                <td class="px-4 text-right">
                                    <div class="action-buttons">
                                        <a asp-action="Update" asp-route-id="@item.Id"
                                               class="btn-icon btn-icon-link btn-edit" title="Chỉnh sửa">
                                            <i class="fas fa-pen"></i>
                                        </a>
                                        <button class="btn-icon btn-delete" onclick="deleteRoom('@item.Id')" title="Xóa">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-transparent border-0 py-4 px-4">
                <nav class="d-flex justify-content-center">
                    <ul class="pagination pagination-rounded mb-0 gap-2">
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link border-0 shadow-sm"
                                   href="?PageNumber=@i&SearchTerm=@Context.Request.Query["SearchTerm"]"
                                   style="border-radius: 10px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/index-meetingRoom.css">
    }
    <style>

    </style>

    @section Scripts {
        <script>
                    function deleteRoom(id) {
                        Swal.fire({
                            title: 'Xác nhận xóa?',
                            text: "Phòng họp sẽ tạm dừng hoạt động và ẩn khỏi danh sách.",
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#ef4444',
                            cancelButtonColor: '#64748b',
                            confirmButtonText: 'Đồng ý xóa',
                            cancelButtonText: 'Bỏ qua'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $.post(`/MeetingRoom/Delete/${id}`, function (response) {
                                    if (response.success) {
                                        Swal.fire({
                                            toast: true,
                                            position: 'top-end',
                                            icon: 'success',
                                            title: response.message,
                                            timer: 2000,
                                            showConfirmButton: false
                                        }).then(() => location.reload());
                                    } else {
                                        Swal.fire('Lỗi', response.message, 'error');
                                    }
                                });
                            }
                        });
                    }
        </script>
    }