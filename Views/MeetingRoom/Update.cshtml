@using MeetingManagement.Models.DTOs
@using MeetingManagement.Enum
@model MeetingRoomUpdateModel

@{
    ViewData["Title"] = "Cập nhật phòng họp";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var companies = ViewBag.Companies as List<CompanyViewModel> ?? new List<CompanyViewModel>();
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Breadcrumb -->
            @* <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 p-0 bg-transparent">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted small">Quản lý Phòng họp</a></li>
                    <li class="breadcrumb-item active small" aria-current="page">Cập nhật</li>
                </ol>
            </nav> *@

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-light btn-sm rounded-circle mr-3 shadow-sm" style="width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;">
                    <i class="fas fa-arrow-left text-muted"></i>
                </a>
                <h3 class="font-weight-bold mb-0">Cập nhật phòng họp</h3>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius: 16px;">
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Update" method="post" id="updateRoomForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-4" style="border-radius: 8px;"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <label asp-for="Name" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Tên phòng họp <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-door-open text-muted"></i></span>
                                    </div>
                                    <input asp-for="Name" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Ví dụ: Meeting Room A101" required>
                                </div>
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Capacity" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Sức chứa (Người) <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-users text-muted"></i></span>
                                    </div>
                                    <input asp-for="Capacity" type="number" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Số lượng tối đa..." required>
                                </div>
                                <span asp-validation-for="Capacity" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-12 mb-4">
                                <label asp-for="Location" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Vị trí <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-map-marker-alt text-muted"></i></span>
                                    </div>
                                    <input asp-for="Location" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" placeholder="Ví dụ: Meeting Room A101" required>
                                </div>
                                <span asp-validation-for="Location" class="text-danger small mt-1"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="CompanyId" class="form-label font-weight-bold text-dark small text-uppercase mb-2">Công ty trực thuộc <span class="text-danger">*</span></label>
                                <div class="input-group input-group-merge">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text bg-light border-right-0"><i class="fas fa-building text-muted"></i></span>
                                    </div>
                                    <select asp-for="CompanyId" class="form-control bg-light border-left-0" style="border-radius: 0 8px 8px 0;" required>
                                        <option value="">-- Chọn công ty --</option>
                                        @foreach (var c in companies)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    </select>
                                </div>
                                <span asp-validation-for="CompanyId" class="text-danger small mt-1"></span>
                            </div>
                        </div>

                        <hr class="my-4 border-light">

                        <div class="d-flex flex-column flex-md-row justify-content-md-end align-items-stretch align-items-md-center gap-2">

                            <a asp-action="Index"
                            class="btn btn-link text-muted text-decoration-none small font-weight-bold w-100 w-md-auto">
                                Hủy bỏ
                            </a>

                            <button type="submit"
                                class="btn btn-primary px-md-5 py-2 font-weight-bold shadow-sm w-100 w-md-auto"
                                style="border-radius:10px;background:#4f46e5;border:none;">
                                <i class="fas fa-save me-2"></i> Lưu thay đổi
                            </button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/update-meetingRoom.css">
}
